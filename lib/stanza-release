#!/usr/bin/env bash
# Complete release workflow from dev branch to tagged release
set -e

# Source shared utilities
# shellcheck source=stanza-common
source "$(dirname "${BASH_SOURCE[0]:-$0}")/stanza-common"


check_git_remote_status() {
    # Inform (verbose tier) about remote skip conditions; the push row
    # in the output already conveys the operative behavior.
    if ! has_remote "origin"; then
        print_row_v remote "no origin configured (remote ops will be skipped)"
    elif [[ "$LOCAL_ONLY" == "true" ]]; then
        print_row_v remote "--local mode (skipping remote ops)"
    fi
}

# ------------------------------------------------------------------------------
# Step tracking and the exit trap
#
# Each release step (bump, push, pr, checks, merge, tag, cycle) calls step_start
# before it changes anything and step_done once its row is printed. When a run exits
# non-zero, on_release_exit names the step that stopped, what it left behind,
# and the command that resumes from there; with --json it emits a failure
# document, so a caller that loses the exit status in a pipe still sees it.
RELEASE_STEP=""
RELEASE_DONE_STEPS=""
RELEASE_PR_MERGED=false
# True once the dev cycle finds dev on the next prerelease, bumped by this run
# or an earlier one, so the failure advice never suggests a second bump.
DEV_ADVANCED=false
# Failures recorded by release_preflight (see preflight_fail).
PREFLIGHT_ERRORS=()
PREFLIGHT_HINTS=()
PREFLIGHT_OUTPUT=()

# Also clears the recorded error and hints, so an error or hint printed by an
# earlier, successful step is not taken as the failing step's own.
step_start() {
    RELEASE_STEP="$1"
    STANZA_LAST_ERROR=""
    STANZA_HINTS=""
    if [[ -n "$STANZA_ERROR_LOG" ]]; then
        : > "$STANZA_ERROR_LOG" 2>/dev/null || true
    fi
}

step_done() {
    RELEASE_DONE_STEPS="${RELEASE_DONE_STEPS:+$RELEASE_DONE_STEPS }$RELEASE_STEP"
    RELEASE_STEP=""
}

# Set FAILED_STATE (what the stopped step left behind), RESUME_CMD (one command
# that finishes the release from there, or empty), and RESUME_NOTES (further
# hint lines, newline-separated) for the step that stopped.
release_failure_advice() {
    local step="$1"
    local tag="${version_tag:-v${RELEASE_TO_VERSION:-}}"
    local base="$BASE_BRANCH"
    local yes="" merge_flags=""
    [[ "$YES_TO_ALL" == "true" ]] && yes=" -y"
    [[ "$LOCAL_ONLY" == "true" ]] && merge_flags=" --local"
    [[ "$NO_PR" == "true" ]] && merge_flags="$merge_flags --no-pr"
    [[ "$NO_DEV_PRERELEASE" == "true" && "$PHASE" != "pr" ]] && merge_flags="$merge_flags --no-dev-cycle"
    local resume_merge="stanza release merge$merge_flags$yes"
    # The same command again resumes at the push and the PR (find_unfinished_bump),
    # with every flag the PR and the merge still read.
    local rerun_flags="$merge_flags"
    [[ -n "$PR_NOTE" ]] && rerun_flags="$rerun_flags --pr-note $(printf '%q' "$PR_NOTE")"
    [[ "$SKIP_CHECKS" == "true" ]] && rerun_flags="$rerun_flags --skip-checks"
    local rerun="stanza release $CMD_LABEL$rerun_flags$yes"
    local manual
    FAILED_STATE=""
    RESUME_CMD=""
    RESUME_NOTES=""
    case "$step" in
        bump)
            FAILED_STATE="the version bump did not complete; nothing was pushed"
            RESUME_NOTES="check git status and git log, undo the partial bump, then re-run: stanza release $CMD_LABEL$yes"
            ;;
        push|pr)
            if [[ "$step" == "push" ]]; then
                FAILED_STATE="$tag is committed on dev but not pushed"
            else
                FAILED_STATE="$tag is pushed to dev; nothing is merged"
            fi
            RESUME_CMD="$rerun"
            [[ "$PHASE" == "pr" ]] && RESUME_NOTES="then review the PR and run: stanza release merge"
            ;;
        checks)
            if release_uses_pr; then
                FAILED_STATE="PR #$RELEASE_PR_NUMBER is open; nothing is merged or tagged"
            else
                FAILED_STATE="$tag is pushed to dev; nothing is merged or tagged"
            fi
            RESUME_CMD="git checkout dev && $resume_merge"
            case "$CHECKS_STOP" in
                failed)
                    if release_uses_pr; then
                        RESUME_NOTES="before resuming, fix the failing checks on dev and push; the PR picks up the fix"
                    else
                        RESUME_NOTES="before resuming, fix the failing runs on dev and push"
                    fi
                    ;;
                timeout)
                    RESUME_NOTES="the resume waits again; STANZA_CHECKS_TIMEOUT sets the limit in seconds (0: none)"
                    ;;
            esac
            RESUME_NOTES="${RESUME_NOTES:+$RESUME_NOTES$'\n'}to merge without waiting: $resume_merge --skip-checks"
            ;;
        merge)
            if [[ "$RELEASE_PR_MERGED" == "true" ]]; then
                # 'release merge' finds the merge on origin and tags it.
                if [[ -n "$RELEASE_PR_NUMBER" ]]; then
                    FAILED_STATE="PR #$RELEASE_PR_NUMBER is merged; $tag is not tagged"
                else
                    FAILED_STATE="the release is merged into $base; $tag is not tagged"
                fi
                RESUME_CMD="git checkout dev && $resume_merge"
            else
                FAILED_STATE="$tag is not released"
                RESUME_CMD="git checkout dev && $resume_merge"
            fi
            ;;
        tag)
            if should_skip_remote; then
                FAILED_STATE="$base has the release merge; $tag is not tagged"
            else
                FAILED_STATE="$base has the release merge; $tag is not pushed"
            fi
            if git rev-parse -q --verify "refs/tags/$tag" >/dev/null 2>&1; then
                RESUME_CMD="git checkout dev && $resume_merge"
            else
                RESUME_CMD="git tag $tag $base && git checkout dev && $resume_merge"
            fi
            ;;
        cycle)
            if [[ "$DEV_ADVANCED" == "true" ]]; then
                FAILED_STATE="$tag is released; dev is advanced locally but not pushed"
                manual="git checkout dev && git push origin dev"
            else
                FAILED_STATE="$tag is released; dev is not advanced"
                if should_skip_remote; then
                    manual="git checkout dev && git merge $base --ff-only"
                    [[ "$PROJECT_TYPE_DETECTED" != "latex" ]] && manual="$manual && stanza release prerelease --local -y"
                else
                    manual="git checkout dev && git pull origin dev && git merge $base --no-ff --no-edit && git push origin dev"
                    [[ "$PROJECT_TYPE_DETECTED" != "latex" ]] && manual="$manual && stanza release prerelease -y"
                fi
            fi
            RESUME_CMD="git checkout dev && $resume_merge"
            RESUME_NOTES="or by hand: $manual"
            ;;
    esac
    if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
        RESUME_NOTES="first finish or abort the merge in progress on $(get_current_branch) (git merge --abort)${RESUME_NOTES:+$'\n'$RESUME_NOTES}"
    fi
}

# EXIT trap for a release run. On a non-zero exit after a step started, print
# that step's row as failed, then (unless the error already printed its own
# hints) the resume command. With --json, emit the failure document:
#   {"ok":false,"failed_step":...,"completed_steps":[...],"error":...,
#    "resume":...,"hint":...}
# failed_step is "preflight" when no step had started. error is the last
# print_error message, read from STANZA_ERROR_LOG when there is one, so an error
# printed inside $(...) counts. When release_preflight refused the run, error
# and hint are its first failure, and errors lists every failure as
# {"error":...,"hint":...}. The exit status is kept.
on_release_exit() {
    local status=$?
    trap - EXIT
    local error="$STANZA_LAST_ERROR"
    if [[ -n "$STANZA_ERROR_LOG" ]]; then
        if [[ -s "$STANZA_ERROR_LOG" ]]; then
            error=$(cat "$STANZA_ERROR_LOG")
        fi
        rm -f "$STANZA_ERROR_LOG"
    fi
    [[ $status -eq 0 ]] && exit 0
    local step="${RELEASE_STEP:-preflight}"
    local own_hints="$STANZA_HINTS"
    # A preflight that reported several failures leads with its first.
    if [[ ${#PREFLIGHT_ERRORS[@]} -gt 0 ]]; then
        error="${PREFLIGHT_ERRORS[0]}"
        own_hints="${PREFLIGHT_HINTS[0]}"
    fi
    FAILED_STATE=""
    RESUME_CMD=""
    RESUME_NOTES=""
    if [[ "$step" != "preflight" ]]; then
        release_failure_advice "$step"
        print_row "$step" "failed${FAILED_STATE:+; $FAILED_STATE}"
        if [[ -z "$own_hints" ]]; then
            [[ -n "$RESUME_CMD" ]] && print_hint "resume: $RESUME_CMD"
            local note
            while IFS= read -r note; do
                [[ -n "$note" ]] && print_hint "$note"
            done <<< "$RESUME_NOTES"
        fi
    fi
    if [[ "$JSON_OUTPUT" == "true" ]]; then
        local steps="" s
        for s in $RELEASE_DONE_STEPS; do
            steps="${steps:+$steps,}\"$s\""
        done
        JSON_BUFFER=""
        json_set command "release"
        [[ "$PHASE" != "full" ]] && json_set phase "$PHASE"
        json_set_raw ok false
        json_set failed_step "$step"
        json_set_raw completed_steps "[$steps]"
        json_set_or_null error "$error"
        if [[ -n "$own_hints" ]]; then
            json_set_raw resume null
            json_set hint "$own_hints"
        else
            json_set_or_null resume "$RESUME_CMD"
            json_set_or_null hint "$RESUME_NOTES"
        fi
        if [[ ${#PREFLIGHT_ERRORS[@]} -gt 0 ]]; then
            local items="" i hint
            for ((i = 0; i < ${#PREFLIGHT_ERRORS[@]}; i++)); do
                hint="null"
                [[ -n "${PREFLIGHT_HINTS[i]}" ]] && hint="\"$(json_escape "${PREFLIGHT_HINTS[i]}")\""
                items="${items:+$items,}{\"error\":\"$(json_escape "${PREFLIGHT_ERRORS[i]}")\",\"hint\":$hint}"
            done
            json_set_raw errors "[$items]"
        fi
        json_emit
    fi
    exit "$status"
}

# Push with diagnosis and (interactively) retry. Returns 0 on success,
# 1 on giving up. The bump commit is already local at the call site, so
# a failure here leaves the user with a clean working tree and a
# retry-able state. Under -y, no prompts: fail fast for CI use.
push_with_retry() {
    local branch="$1"
    local max_attempts=3
    local attempt=1
    while [[ $attempt -le $max_attempts ]]; do
        if quiet_try git_net push origin "$branch"; then
            return 0
        fi
        local status ahead behind
        status=$(get_branch_status "$branch" 2>/dev/null || echo "0 0")
        ahead=$(echo "$status" | awk '{print $1+0}')
        behind=$(echo "$status" | awk '{print $2+0}')
        print_warning "push to origin/$branch failed (ahead=$ahead, behind=$behind)"
        if [[ "$behind" -gt 0 ]]; then
            print_hint "git pull --rebase origin $branch   # then re-run, or retry below"
        fi
        if [[ "$YES_TO_ALL" == "true" ]]; then
            return 1
        fi
        if [[ $attempt -ge $max_attempts ]]; then
            print_warning "max retries reached"
            return 1
        fi
        read -p "Retry push to origin/$branch? (y/N): " -n 1 -r
        echo
        [[ "$REPLY" =~ ^[Yy]$ ]] || return 1
        attempt=$((attempt + 1))
    done
    return 1
}

# Tag and push version: HEAD, or the commit given.
# Usage: git_tag_version <tag> [commit]
# Side-effect: sets RELEASE_TAG_NAME, RELEASE_TAG_PUSHED at module scope.
git_tag_version() {
    local version="$1" target="${2:-HEAD}"
    step_start tag

    # Check if tag already exists
    if [ -n "$(git tag -l "$version")" ]; then
        print_error "Tag $version already exists. Existing tags:"
        git tag --sort=-version:refname | head -5 >&2
        print_hint "$BASE_BRANCH has the release merge, untagged; check the existing tag (git show $version) and tag by hand"
        exit 1
    fi
    git tag "$version" "$target"
    RELEASE_TAG_NAME="$version"

    # Push to remote if not in local-only mode. --atomic: the remote updates
    # both refs or neither, so a refused base branch (e.g. a protected branch
    # under --no-pr) never leaves the tag pushed without its release merge.
    # The push output is kept so a refusal shows the remote's reason.
    if ! should_skip_remote; then
        local push_out
        if push_out=$(git_net push --atomic origin "$BASE_BRANCH" "refs/tags/$version" 2>&1); then
            if [[ "$VERBOSE" == "true" ]]; then printf '%s\n' "$push_out"; fi
        else
            print_error "push of $BASE_BRANCH and tag $version to origin failed; neither was pushed"
            print_output "$push_out"
            if [[ "$NO_PR" == "true" ]]; then
                git tag -d "$version" > /dev/null
                print_hint "the bump is already on origin/dev; the local tag $version was removed"
                print_hint "if $BASE_BRANCH is protected, release through a PR instead:"
                print_hint "  git checkout dev && git branch -f $BASE_BRANCH origin/$BASE_BRANCH"
                # The merge phase follows 'release pr', whose PR is still open.
                if [[ "$PHASE" != "merge" ]]; then
                    print_hint "  gh pr create --base $BASE_BRANCH --head dev --title $version --fill"
                fi
                print_hint "  stanza release merge"
            else
                # The local tag is kept; 'release merge' finds it, pushes it, and
                # runs the dev cycle.
                print_hint "retry: git push --atomic origin $BASE_BRANCH refs/tags/$version"
                if [[ "$NO_DEV_PRERELEASE" != "true" ]]; then
                    local yes=""
                    [[ "$YES_TO_ALL" == "true" ]] && yes=" -y"
                    print_hint "or resume (pushes the tag, then opens the dev cycle): git checkout dev && stanza release merge$yes"
                fi
            fi
            exit 1
        fi
        print_row tag "$version  pushed"
        RELEASE_TAG_PUSHED=true
    else
        print_row tag "$version  (local)"
        RELEASE_TAG_PUSHED=false
    fi
    step_done
}

# Find the package __init__.py path from pyproject.toml
find_package_init() {
    local pkg_dir=""

    # Try packages = [{include = "..."}] from pyproject.toml
    pkg_dir=$(grep 'packages.*include' pyproject.toml 2>/dev/null \
        | head -1 \
        | sed 's/.*include *= *"\([^"]*\)".*/\1/' 2>/dev/null || true)

    # Fall back: use project name from pyproject.toml
    if [[ -z "$pkg_dir" ]]; then
        pkg_dir=$(grep '^name *=' pyproject.toml 2>/dev/null \
            | head -1 \
            | sed 's/.*= *"\([^"]*\)".*/\1/' 2>/dev/null || true)
    fi

    if [[ -n "$pkg_dir" && -f "$pkg_dir/__init__.py" ]]; then
        echo "$pkg_dir/__init__.py"
    fi
}

# Update __version__ in package __init__.py
update_init_version() {
    local version="$1"
    validate_version_string "$version"
    local init_file
    init_file=$(find_package_init)

    if [[ -z "$init_file" ]]; then
        return 0
    fi

    # Only update if the file contains a __version__ line
    if grep -q '^__version__ *= *"' "$init_file" 2>/dev/null; then
        sed "s/^__version__ *= *\"[^\"]*\"/__version__ = \"$version\"/" "$init_file" > "$init_file.tmp" && mv "$init_file.tmp" "$init_file"
        git add "$init_file"
        if [[ $VERBOSE == "true" ]]; then
            echo "updated $init_file to $version" >&2
        fi
    fi
}

# Commit version bump with proper handling of other changes
bump_and_commit_version() {
    local bump_type="${1:-prerelease}"
    local specific_version="${2:-}"
    local project_type
    project_type=$(detect_project_type)

    # Use specific version if provided, otherwise use bump type
    local version
    if [[ -n "$specific_version" ]]; then
        version=$(set_version "$specific_version")
    else
        version=$(bump_version "$bump_type")
    fi

    case "$project_type" in
        uv)
            update_init_version "$version"
            uv lock --quiet
            git add pyproject.toml uv.lock
            ;;
        bash)
            git add VERSION
            ;;
        latex)
            local latex_file
            latex_file=$(get_latex_file)
            git add "$latex_file"
            ;;
    esac

    # README title version (opt-in): keep an existing "v<version>" token in the
    # H1 title synced to the version source. No-op when absent or already current.
    # Record what happened in module-scope flags so the caller can print the
    # readme/promote rows right after its bump row (this function commits before
    # the caller's bump row, so printing here would mis-order the output).
    BUMP_README_SYNCED=""
    if set_version_in_readme "$version"; then
        git add README.md
        BUMP_README_SYNCED="v$version"
        RELEASE_README_SYNCED=true
    fi

    # CHANGELOG promotion: stable releases only (skips prereleases and the
    # post-release dev-cycle bump). An empty [Unreleased] was already rejected by
    # release_preflight; promote_changelog promotes a populated one
    # in place and is a no-op (returns non-zero) otherwise.
    BUMP_CHANGELOG_PROMOTED=""
    if [[ "$NO_CHANGELOG" != "true" && "$version" != *a* ]]; then
        if promote_changelog "$version"; then
            git add CHANGELOG.md
            BUMP_CHANGELOG_PROMOTED="$version"
            RELEASE_CHANGELOG_PROMOTED=true
        fi
    fi

    git_quiet commit -m "version [$bump_type]: $version"
    if ! should_skip_remote; then
        check_uncommitted_changes
    fi
}

# Print the readme/promote rows recorded by the most recent
# bump_and_commit_version call. Callers invoke this right after their bump row so
# the doc-sync rows sit between bump and commit. Always returns 0.
print_doc_sync_rows() {
    [[ -n "$BUMP_README_SYNCED" ]] && print_row readme "title -> $BUMP_README_SYNCED"
    [[ -n "$BUMP_CHANGELOG_PROMOTED" ]] && print_row promote "CHANGELOG [Unreleased] -> [$BUMP_CHANGELOG_PROMOTED]"
    return 0
}


# Bump version using the detected project type and return new version
bump_version() {
    local bump_type="$1"
    local old_version
    old_version=$(get_current_version)
    local project_type
    project_type=$(detect_project_type)

    case "$project_type" in
        uv)
            validate_version_string "$old_version"
            if [[ "$bump_type" == "prerelease" ]]; then
                if [[ "$old_version" == *a* ]]; then
                    uv version --bump alpha --frozen > /dev/null
                else
                    uv version --bump patch --bump alpha=0 --frozen > /dev/null
                fi
            elif [[ "$bump_type" == "patch" && "$old_version" == *a* ]]; then
                uv version --bump stable --frozen > /dev/null
            else
                uv version --bump "$bump_type" --frozen > /dev/null
            fi
            ;;
        bash)
            local new_ver
            new_ver=$(bump_version_string "$old_version" "$bump_type")
            set_version_in_file "$new_ver"
            ;;
        latex)
            local new_ver
            new_ver=$(bump_latex_version_string "$old_version" "$bump_type")
            set_version_in_latex "$new_ver"
            ;;
    esac

    local new_version
    new_version=$(get_current_version)
    if [[ $VERBOSE == "true" ]]; then
        echo "version update [$(get_current_branch)] : $old_version ⟶ $new_version" >&2
    fi
    # Return new version for caller to use
    echo "$new_version"
}

# Set specific version using the detected project type and return new version
set_version() {
    local target_version="$1"
    local old_version
    old_version=$(get_current_version)
    local project_type
    project_type=$(detect_project_type)

    case "$project_type" in
        uv)
            validate_version_string "$target_version"
            uv version "$target_version" --frozen > /dev/null
            ;;
        bash)
            validate_version_string "$target_version"
            set_version_in_file "$target_version"
            ;;
        latex)
            validate_latex_version_string "$target_version"
            set_version_in_latex "$target_version"
            ;;
    esac

    local new_version
    new_version=$(get_current_version)
    if [[ $VERBOSE == "true" ]]; then
        echo "version update [$(get_current_branch)] : $old_version ⟶ $new_version" >&2
    fi

    # Return new version for caller to use
    echo "$new_version"
}

# Default values (VERBOSE/VERBOSITY/JSON_OUTPUT may already be set by bin/stanza)
BUMP_TYPE=""
PHASE="full"          # full | pr | merge
PR_NOTE=""
MERGE_PR_NUMBER=""
HELP=false
LOCAL_ONLY=false
YES_TO_ALL=false
NO_DEV_PRERELEASE=false
NO_CHANGELOG=false
# Release-outcome accumulators, OR'd across every bump in this run and emitted in
# the JSON doc: whether a README title token was synced and whether a CHANGELOG
# [Unreleased] section was promoted at any point during the release. They are
# per-invocation: in the two-phase pr/merge flow the changelog is promoted (and
# reported true) by the pr run, while the separate merge run re-derives nothing
# and reports changelog_promoted=false.
RELEASE_README_SYNCED=false
RELEASE_CHANGELOG_PROMOTED=false
VERBOSE="${VERBOSE:-false}"
NO_PR=false
SKIP_CHECKS=false
CHECK_ONLY=false

# Detect a leading phase token (pr|merge) before the bump-type parser.
# Phases let the workflow run in two stages: open the PR, pause for review,
# then merge. Everything after the phase token parses exactly as before.
case "${1:-}" in
    pr)    PHASE="pr";    shift ;;
    merge) PHASE="merge"; shift ;;
esac

# From here on a failed run names its step and how to resume (see
# on_release_exit); a usage error fails at "preflight", before any step
STANZA_ERROR_LOG=$(mktemp "${TMPDIR:-/tmp}/stanza-error.XXXXXX" 2>/dev/null) || STANZA_ERROR_LOG=""
trap on_release_exit EXIT

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        patch|minor|major|pre|prerelease)
            if [ -n "$BUMP_TYPE" ]; then
                print_error "Multiple bump types specified"
                exit 1
            fi
            if [[ "$1" == "pre" ]]; then
                BUMP_TYPE="prerelease"
            else
                BUMP_TYPE="$1"
            fi
            shift
            ;;
        [0-9]*)
            # A bare number is the optional PR pin for the merge phase.
            if [[ "$PHASE" == "merge" && "$1" =~ ^[0-9]+$ ]]; then
                MERGE_PR_NUMBER="$1"
                shift
            else
                print_error "Unknown option '$1'"
                echo "Use -h or --help for usage information" >&2
                exit 1
            fi
            ;;
        --pr-note)
            if [[ -z "${2:-}" ]]; then
                print_error "--pr-note requires a value"
                exit 1
            fi
            PR_NOTE="$2"
            shift 2
            ;;
        --pr-note=*)
            PR_NOTE="${1#*=}"
            shift
            ;;
        --local)
            LOCAL_ONLY=true
            shift
            ;;
        --no-pr)
            NO_PR=true
            shift
            ;;
        --skip-checks)
            SKIP_CHECKS=true
            shift
            ;;
        --check)
            CHECK_ONLY=true
            shift
            ;;
        --no-dev-cycle)
            NO_DEV_PRERELEASE=true
            shift
            ;;
        --no-changelog)
            NO_CHANGELOG=true
            shift
            ;;
        -y|--yes)
            YES_TO_ALL=true
            shift
            ;;
        -q|--quiet)
            QUIET_REQUESTED=true
            VERBOSITY=0
            shift
            ;;
        --verbose)
            VERBOSE_REQUESTED=true
            if [[ $VERBOSITY -lt 2 ]]; then VERBOSITY=2; else VERBOSITY=$((VERBOSITY + 1)); fi
            VERBOSE=true
            shift
            ;;
        -v*)
            if [[ "$1" =~ ^-v+$ ]]; then
                VERBOSE_REQUESTED=true
                vcount=$((${#1} - 1))
                target=$((vcount + 1))
                [[ $VERBOSITY -lt $target ]] && VERBOSITY=$target
                VERBOSE=true
                shift
            else
                print_error "Unknown option '$1'"
                echo "Use -h or --help for usage information" >&2
                exit 1
            fi
            ;;
        --json)
            JSON_OUTPUT=true
            shift
            ;;
        --no-color)
            NO_COLOR_OVERRIDE=true
            shift
            ;;
        -h|--help)
            HELP=true
            shift
            ;;
        *)
            print_error "Unknown option '$1'"
            echo "Use -h or --help for usage information" >&2
            exit 1
            ;;
    esac
done

# Re-sync VERBOSE with VERBOSITY (handles the case where bin/stanza set
# VERBOSITY but we did not see -v locally).
if [[ "$VERBOSITY" -ge 3 ]]; then
    VERBOSE=true
fi

# Validate after both bin/stanza-level and subcommand-level flag parsing.
check_verbosity_exclusion

print_release_help() {
    cat <<'EOF'
Create a release: bump the version and ship it through dev -> main.

Usage:
  stanza release <BUMP_TYPE>          Full release (bump, PR, merge, tag, new cycle)
  stanza release pr <BUMP_TYPE>       Phase 1: bump on dev, open PR, then stop
  stanza release merge [PR_NUMBER]    Phase 2: merge the open PR, tag, open new cycle

Arguments:
  <BUMP_TYPE>  Type of version bump:
                 patch         Promote alpha to stable, or bump patch (0.1.1a0 -> 0.1.1)
                 minor         Bump minor, zero patch (0.1.1 -> 0.2.0)
                 major         Bump major, zero minor and patch (0.2.0 -> 1.0.0)
                 prerelease    Bump to next alpha (0.1.0 -> 0.1.1a0); no PR  [alias: pre]
  [PR_NUMBER]  (merge only) pin a specific open PR when more than one exists

Phases let an agent pause for review between opening and merging a PR.
'prerelease' opens no PR, so phase subcommands (pr, merge) do not apply to it.
--no-pr merges dev into the base branch directly and pushes it with the tag;
a protected base branch refuses that push, and nothing is tagged remotely.

A run that stops partway names the step that failed and the command that
resumes it. The same 'release <type>' or 'release pr <type>' resumes a bump
that is on dev but not released: it pushes dev and opens the PR instead of
bumping again. 'merge' resumes a release that is already merged: it tags the
PR's merge when the tag is missing, pushes the tag if only this clone has it
(with the base branch, after a --local release), then runs the dev cycle.
A git transfer that stays below 1000 bytes/s for STANZA_NET_STALL_SECONDS
(default 30) is abandoned; 0 turns the limit off.

The merge waits for CI: the release PR's checks, or with --no-pr the workflow
runs on dev's head. A failed or cancelled check stops the release before the
merge, with the PR left open; no checks at all is a pass. The wait gives up
after STANZA_CHECKS_TIMEOUT seconds (default 1800; 0 waits without limit). A
release also refuses to bump a dev whose head already failed CI.

Before it changes anything, a release checks everything the phase needs: the
branch, a clean tree, dev level with origin, gh authentication, the target tag
free locally and on origin and above the latest tag, and for 'merge' the open
PR. Every failed check is reported in one run. --check runs only these checks.

Options:
      --pr-note <TEXT>     Append a note to the PR body (full and pr phases)
      --no-pr              Merge dev into the base branch directly, without a
                           PR (full and merge phases; remote steps still run)
      --skip-checks        Merge without waiting for CI, and bump a dev whose
                           CI failed (for checks known broken for other reasons)
      --check              Run the preflight checks only, change nothing, and
                           exit 0 when the release could go ahead
      --no-dev-cycle  Skip the post-release dev cycle: no merge-back to
                           dev and no next prerelease bump (full and merge phases)
      --no-changelog       Skip CHANGELOG [Unreleased] promotion and its
                           empty-section pre-flight check
  -y, --yes                Auto-confirm all prompts (useful for CI/CD)
      --local              Local-only mode (skip all remote operations)
  -q, --quiet              Reduce output to one-line outcomes (errors still print)
  -v, --verbose            Show step internals (-vv dumps every git/gh command)
      --json               Emit a single JSON document on stdout
      --no-color           Disable ANSI color (also honors NO_COLOR env)
  -h, --help               Print help

Examples:
  stanza release prerelease                Bump to next prerelease (no PR)
  stanza release pre                       Same as 'prerelease' (alias)
  stanza release patch                     Full release; PR dev -> main, merge, tag
  stanza release patch -y                  Non-interactive full release
  stanza release patch -y --no-pr          Full release, merging dev without a PR
  stanza release pr minor -y               Phase 1: bump + open PR, then stop for review
  stanza release merge -y                  Phase 2: merge the open PR, tag, new cycle
  stanza release pr patch --pr-note "..."  Open PR with a note in its body
  stanza release patch -y --no-dev-cycle  Release, but leave dev untouched
  stanza release patch -y --no-changelog  Release without promoting CHANGELOG
  stanza release merge -y --skip-checks   Merge without waiting for CI
  stanza release patch --check             Check a patch release could run
  stanza --json release patch -y           Machine-readable output
EOF
}

# Show help if requested.
if [[ $HELP == true ]]; then
    print_release_help
    exit 0
fi

# Phase-aware argument validation.
if [[ "$PHASE" != "full" && "$BUMP_TYPE" == "prerelease" ]]; then
    print_error "prereleases open no PR; phase subcommands do not apply" \
        "use 'stanza release prerelease' (no phase)"
    exit 1
fi
if [[ "$PHASE" == "merge" ]]; then
    # merge re-derives the version from the open PR; a bump type is meaningless.
    if [[ -n "$BUMP_TYPE" ]]; then
        print_error "merge takes no bump type; the version is derived from the open PR" \
            "run 'stanza release merge' (optionally with a PR number)"
        exit 1
    fi
elif [[ -z "$BUMP_TYPE" ]]; then
    if [[ "$PHASE" == "pr" ]]; then
        print_error "missing bump type for 'release pr'" \
            "specify one: stanza release pr patch|minor|major"
        exit 1
    fi
    # Bare 'stanza release' (full phase, no type): print help, as before.
    print_release_help
    exit 0
fi

# Deferred initialization (after help check, so --help works without a version file)
CURRENT_VERSION=$(get_current_version) || exit 1
CURRENT_BRANCH=$(get_current_branch)
BASE_BRANCH=$(get_base_branch)
PROJECT_TYPE_DETECTED=$(detect_project_type)

# Command label for the header and error hints (reflects the active phase).
case "$PHASE" in
    pr)    CMD_LABEL="pr $BUMP_TYPE" ;;
    merge) CMD_LABEL="merge" ;;
    *)     CMD_LABEL="$BUMP_TYPE" ;;
esac

# Header banner (skipped when --json or --quiet are set; helpers handle gating)
if [[ "$BUMP_TYPE" == "prerelease" ]]; then
    HEADER_CONTEXT="$CURRENT_BRANCH, $PROJECT_TYPE_DETECTED"
else
    HEADER_CONTEXT="$CURRENT_BRANCH -> $BASE_BRANCH, $PROJECT_TYPE_DETECTED"
fi

# --no-pr changes only the merge step. A prerelease opens no PR and the pr phase
# exists to open one, so the flag is ignored there; with no PR, a --pr-note has
# nothing to attach to. A prerelease reads no CI, so --skip-checks is moot there.
# Settled before the header, which reports NO_PR; the warnings print after it.
FLAG_WARNINGS=()
if [[ "$NO_PR" == "true" ]]; then
    if [[ "$BUMP_TYPE" == "prerelease" ]]; then
        FLAG_WARNINGS+=("--no-pr is ignored by prerelease, which opens no PR")
        NO_PR=false
    elif [[ "$PHASE" == "pr" ]]; then
        FLAG_WARNINGS+=("--no-pr is ignored by 'release pr', which opens a PR")
        NO_PR=false
    elif [[ -n "$PR_NOTE" ]]; then
        FLAG_WARNINGS+=("--pr-note is ignored with --no-pr (no PR is opened)")
        PR_NOTE=""
    fi
fi
if [[ "$SKIP_CHECKS" == "true" && "$BUMP_TYPE" == "prerelease" ]]; then
    FLAG_WARNINGS+=("--skip-checks is ignored by prerelease, which reads no checks")
fi

[[ "$LOCAL_ONLY" == "true" ]] && HEADER_CONTEXT="$HEADER_CONTEXT, local"
[[ "$NO_PR" == "true" ]] && HEADER_CONTEXT="$HEADER_CONTEXT, no PR"
[[ "$CHECK_ONLY" == "true" ]] && HEADER_CONTEXT="$HEADER_CONTEXT, check only"
print_header "release $CMD_LABEL" "$HEADER_CONTEXT"
print_row_v checks "branch=$CURRENT_BRANCH, project=$PROJECT_TYPE_DETECTED, phase=$PHASE, yes=$YES_TO_ALL"
for _warning in "${FLAG_WARNINGS[@]}"; do
    print_warning "$_warning"
done

# ------------------------------------------------------------------------------

# Handle prerelease workflow (release_preflight has checked it can run)
handle_prerelease_workflow() {
    confirm_step "Create [$BUMP_TYPE] version commit on current branch"

    step_start bump
    local old_version="$CURRENT_VERSION"
    bump_and_commit_version "$BUMP_TYPE"
    local new_version
    new_version=$(get_current_version)
    local sha
    sha=$(git rev-parse --short HEAD)
    print_row bump "$old_version -> $new_version"
    print_doc_sync_rows
    print_row commit "$sha  \"version [$BUMP_TYPE]: $new_version\""
    step_done

    # A failed push is reported and kept local; the run still succeeds.
    local pushed="false"
    if ! should_skip_remote; then
        if push_with_retry "$CURRENT_BRANCH"; then
            print_row push "origin/$CURRENT_BRANCH"
            pushed="true"
        else
            print_row push "failed (commit kept locally — push manually with: git push origin $CURRENT_BRANCH)"
        fi
    elif [[ "$LOCAL_ONLY" == "true" ]]; then
        print_row push "skipped (--local)"
    else
        print_row push "skipped (no remote)"
    fi

    json_set command "release"
    json_set_raw ok true
    json_set bump_type "$BUMP_TYPE"
    json_set project_type "$PROJECT_TYPE_DETECTED"
    json_set from_version "$old_version"
    json_set to_version "$new_version"
    json_set branch "$CURRENT_BRANCH"
    json_set commit "$sha"
    json_set_raw pushed "$pushed"
    json_set_raw readme_synced "$RELEASE_README_SYNCED"
    json_set_raw changelog_promoted "$RELEASE_CHANGELOG_PROMOTED"
    json_emit

    if [[ "$VERBOSITY" -le 0 ]]; then
        # Quiet mode: just the new version on stdout
        if [[ "$JSON_OUTPUT" != "true" ]]; then
            echo "$new_version"
        fi
    else
        print_done "$new_version on $CURRENT_BRANCH"
    fi
    exit 0
}

# Step 1: Create version bump commit on dev branch.
# Side-effect: sets RELEASE_FROM_VERSION, RELEASE_TO_VERSION, RELEASE_COMMIT_SHA,
# RELEASE_PUSHED at module scope for downstream JSON emission. release_preflight
# has checked that it can run.
create_version_bump_on_dev() {
    if [[ "$BUMP_RESUMED" == "true" ]]; then
        resume_version_bump_on_dev
        return 0
    fi
    RELEASE_FROM_VERSION="$CURRENT_VERSION"
    confirm_step "1: Create version bump [$BUMP_TYPE] commit on dev branch"
    step_start bump
    bump_and_commit_version "$BUMP_TYPE"
    RELEASE_TO_VERSION=$(get_current_version)
    RELEASE_COMMIT_SHA=$(git rev-parse --short HEAD)
    print_row bump "$RELEASE_FROM_VERSION -> $RELEASE_TO_VERSION  on dev"
    print_doc_sync_rows
    print_row commit "$RELEASE_COMMIT_SHA  \"version [$BUMP_TYPE]: $RELEASE_TO_VERSION\""
    step_done

    RELEASE_PUSHED=false
    if ! should_skip_remote; then
        step_start push
        git_quiet push origin dev
        print_row push "origin/dev"
        step_done
        RELEASE_PUSHED=true
    elif [[ "$LOCAL_ONLY" == "true" ]]; then
        print_row push "skipped (--local)"
    else
        print_row push "skipped (no remote)"
    fi
}

# Step 1, resumed: dev already carries the bump an earlier run committed
# (find_unfinished_bump). Push it unless origin/dev has it. Sets the variables
# create_version_bump_on_dev sets; RELEASE_FROM_VERSION is empty, since the run
# did not see the version before the bump.
resume_version_bump_on_dev() {
    RELEASE_FROM_VERSION=""
    RELEASE_TO_VERSION="$CURRENT_VERSION"
    RELEASE_COMMIT_SHA=$(git rev-parse --short HEAD)
    confirm_step "1: Resume the $BUMP_TYPE bump to $RELEASE_TO_VERSION already on dev"
    step_start bump
    print_row bump "$RELEASE_TO_VERSION on dev, committed earlier ($RELEASE_COMMIT_SHA); resuming"
    step_done

    RELEASE_PUSHED=false
    if ! should_skip_remote; then
        step_start push
        if [[ "$(git rev-parse dev)" == "$(git rev-parse -q --verify refs/remotes/origin/dev)" ]]; then
            print_row push "origin/dev (already pushed)"
        else
            git_quiet push origin dev
            print_row push "origin/dev"
        fi
        step_done
        RELEASE_PUSHED=true
    elif [[ "$LOCAL_ONLY" == "true" ]]; then
        print_row push "skipped (--local)"
    else
        print_row push "skipped (no remote)"
    fi
}

# Number of the most-recent open dev->base PR, or empty if none.
# The `// empty` keeps a missing PR as the empty string (not the literal
# "null"), so callers can test it with [[ -z ... ]].
gh_get_last_open_pr_number() {
    gh pr list --base "$BASE_BRANCH" --head dev --state open --json number --jq '.[0].number // empty'
}

# ------------------------------------------------------------------------------
# CI gate
#
# A release merge waits for CI on what it ships: the release PR's checks, or
# under --no-pr the workflow runs on dev's head commit. A failed or cancelled
# check stops the release before anything is merged or tagged; on a commit,
# only the newest run of each workflow counts. Nothing is a pass before
# STANZA_CHECKS_GRACE_SECONDS (default 15) has passed, so a slow workflow can
# register; no checks at all is then a pass. STANZA_CHECKS_TIMEOUT (default 1800; 0 = no limit) bounds
# the wait; STANZA_CHECKS_INTERVAL (default 10) is the poll interval.
# --skip-checks bypasses all of it.

# Result of the merge gate, for the JSON doc: passed, none, skipped, or
# unavailable (--no-pr, where gh cannot read the runs). Empty when not read.
CHECKS_RESULT=""
# Why the checks step stopped (failed, timeout, or error), for the exit advice.
CHECKS_STOP=""

# A non-negative integer setting from the environment, or the default.
# Usage: checks_seconds STANZA_CHECKS_TIMEOUT 1800
checks_seconds() {
    local value="${!1:-$2}"
    [[ "$value" =~ ^[0-9]+$ ]] || value="$2"
    echo $((10#$value))
}

# Read CI once into CI_LINES, one "<bucket>\t<name>" line per check, bucket
# one of pass, fail, or pending. Returns 0, 2 when no checks are reported, and
# 1 when gh fails (its output in CI_READ_ERROR). Sets globals, so call it
# directly, not in $(...).
# Usage: read_ci pr <number> | read_ci commit <sha>
CI_LINES=""
CI_READ_ERROR=""
read_ci() {
    local kind="$1" ref="$2" out err status=0
    err=$(mktemp "${TMPDIR:-/tmp}/stanza-ci.XXXXXX")
    if [[ "$kind" == "pr" ]]; then
        out=$(gh pr checks "$ref" --json bucket,name \
            --jq '.[] | "\(.bucket)\t\(.name)"' 2>"$err") || status=$?
    else
        out=$(gh run list --commit "$ref" --json status,conclusion,workflowName \
            --jq '.[] | "\(.status)\t\(.conclusion)\t\(.workflowName)"' 2>"$err") || status=$?
    fi
    CI_READ_ERROR=$(cat "$err")
    rm -f "$err"
    CI_LINES=""
    if [[ $status -ne 0 ]]; then
        # gh pr checks reports a PR without checks as an error.
        [[ "$CI_READ_ERROR" == *"no checks reported"* ]] && return 2
        CI_READ_ERROR="${CI_READ_ERROR:-${out}}"
        return 1
    fi
    [[ -n "$out" ]] || return 2
    # Fields are split by expansion, not `IFS=$'\t' read`: tab is IFS
    # whitespace, so read collapses an empty field (an unfinished run's
    # conclusion) and shifts the name into it.
    local line bucket name run_status conclusion rest seen=$'\n'
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        if [[ "$kind" == "pr" ]]; then
            bucket="${line%%$'\t'*}"
            name="${line#*$'\t'}"
            case "$bucket" in
                pass|skipping) bucket=pass ;;
                fail|cancel)   bucket=fail ;;
                *)             bucket=pending ;;
            esac
        else
            run_status="${line%%$'\t'*}"
            rest="${line#*$'\t'}"
            conclusion="${rest%%$'\t'*}"
            name="${rest#*$'\t'}"
            # gh lists runs newest first; a re-run or a run cancelled by a
            # newer one is superseded by that run, so keep one per workflow.
            [[ "$seen" == *$'\n'"$name"$'\n'* ]] && continue
            seen="$seen$name"$'\n'
            if [[ "$run_status" != "completed" ]]; then
                bucket=pending
            else
                case "$conclusion" in
                    failure|cancelled|timed_out|startup_failure) bucket=fail ;;
                    *) bucket=pass ;;
                esac
            fi
        fi
        CI_LINES="$CI_LINES$bucket"$'\t'"$name"$'\n'
    done <<< "$out"
}

# The names of the CI_LINES checks in one bucket, comma-separated.
# Usage: ci_names fail
ci_names() {
    printf '%s' "$CI_LINES" | awk -F'\t' -v b="$1" \
        '$1 == b { printf "%s%s", sep, ($2 == "" ? "(unnamed)" : $2); sep = ", " }'
}

# The number of CI_LINES checks in one bucket. Decisions use the count, not
# ci_names, so a check without a name still counts.
# Usage: ci_count pending
ci_count() {
    printf '%s' "$CI_LINES" | awk -F'\t' -v b="$1" '$1 == b { n++ } END { print n + 0 }'
}

# Wait for the checks of a PR or the runs on a commit to finish. Sets
# CHECKS_RESULT (passed or none) and prints the checks row on success. On a
# failed check or a timeout, prints the error, sets CHECKS_STOP, and returns 1.
# A read error is retried, one poll interval apart, so a network blip does not
# stop a release; after CHECKS_READ_ATTEMPTS failed reads in a row, sets
# CHECKS_STOP=error and returns 1 without printing, so the caller decides
# whether it stops the release.
# Usage: wait_for_ci pr <number> "PR #1" | wait_for_ci commit <sha> "dev (abc1234)"
CHECKS_READ_ATTEMPTS=3
wait_for_ci() {
    local kind="$1" ref="$2" what="$3"
    local timeout grace interval settle
    timeout=$(checks_seconds STANZA_CHECKS_TIMEOUT 1800)
    grace=$(checks_seconds STANZA_CHECKS_GRACE_SECONDS 15)
    interval=$(checks_seconds STANZA_CHECKS_INTERVAL 10)
    settle=$(( interval < 3 ? interval : 3 ))
    local start=$SECONDS waited=false status elapsed pending total read_failures=0
    while true; do
        status=0
        read_ci "$kind" "$ref" || status=$?
        elapsed=$((SECONDS - start))
        if [[ $status -eq 1 ]]; then
            read_failures=$((read_failures + 1))
            if [[ $read_failures -ge $CHECKS_READ_ATTEMPTS ]] ||
                [[ $timeout -gt 0 && $elapsed -ge $timeout ]]; then
                CHECKS_STOP=error
                return 1
            fi
            if [[ "$kind" == "pr" ]]; then
                print_warning "could not read the checks of $what; retrying in ${interval}s"
            else
                print_warning "could not read the CI runs on $what; retrying in ${interval}s"
            fi
            sleep "$interval"
            continue
        fi
        read_failures=0
        if [[ $status -eq 2 ]]; then
            if [[ $elapsed -ge $grace ]]; then
                CHECKS_RESULT=none
                print_row checks "none reported"
                return 0
            fi
            sleep "$settle"
            continue
        fi
        if [[ $(ci_count fail) -gt 0 ]]; then
            CHECKS_STOP=failed
            print_error "$what has failing checks: $(ci_names fail)"
            return 1
        fi
        pending=$(ci_names pending)
        if [[ $(ci_count pending) -eq 0 ]]; then
            # A slower workflow may not have registered yet; give it the
            # same grace as a PR with no checks before calling this a pass.
            if [[ $elapsed -lt $grace ]]; then
                sleep "$settle"
                continue
            fi
            total=$(ci_count pass)
            CHECKS_RESULT=passed
            if [[ "$waited" == "true" ]]; then
                print_row checks "$total passed after ${elapsed}s"
            else
                print_row checks "$total passed"
            fi
            return 0
        fi
        if [[ $timeout -gt 0 && $elapsed -ge $timeout ]]; then
            CHECKS_STOP=timeout
            print_error "$what checks still pending after ${timeout}s: $pending"
            return 1
        fi
        if [[ "$waited" != "true" ]]; then
            waited=true
            print_row checks "waiting on $pending"
        fi
        sleep "$interval"
    done
}

# Whether gh can read CI for this repo. The PR path requires gh and preflight
# checked its auth; under --no-pr, gh is optional and the gate is best-effort.
ci_readable() {
    release_uses_pr && return 0
    command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1
}

# Refuse to bump a dev whose head commit already failed CI, so a known-red dev
# gets no version commit pushed onto it. Runs still in progress are not waited
# on: the merge gate waits on the release commit itself. A preflight check: a
# failure is recorded with preflight_fail.
check_dev_ci_before_bump() {
    should_skip_remote && return 0
    [[ "$SKIP_CHECKS" == "true" ]] && return 0
    ci_readable || return 0
    local sha status=0
    sha=$(git rev-parse dev)
    read_ci commit "$sha" || status=$?
    if [[ $status -eq 1 ]]; then
        # Early warning only: the merge gate is the check that stops a release,
        # so a token that cannot read Actions runs does not block the bump.
        print_warning "could not read the CI runs on dev (${sha:0:7}); not checked"
        return 0
    fi
    [[ $status -eq 0 ]] || { print_row_v checks "dev (${sha:0:7}): no runs reported"; return 0; }
    local failed
    if [[ $(ci_count fail) -gt 0 ]]; then
        failed=$(ci_names fail)
        local yes=""
        [[ "$YES_TO_ALL" == "true" ]] && yes=" -y"
        preflight_fail "CI failed on dev's head (${sha:0:7}): $failed; not bumping" \
            "fix on dev and push, then: stanza release $CMD_LABEL$yes"$'\n'"or, if the failure is unrelated to the release: stanza release $CMD_LABEL$yes --skip-checks"
        return 0
    fi
    print_row_v checks "dev (${sha:0:7}): no failed runs"
}

# The merge gate: wait for CI on what is about to be merged, as its own step.
# Usage: wait_for_release_ci pr <number> | wait_for_release_ci commit <sha>
wait_for_release_ci() {
    local kind="$1" ref="$2" what
    step_start checks
    if [[ "$SKIP_CHECKS" == "true" ]]; then
        CHECKS_RESULT=skipped
        print_row checks "skipped (--skip-checks)"
        print_warning "merging without waiting for CI (--skip-checks)"
        step_done
        return 0
    fi
    if [[ "$kind" == "commit" ]] && ! ci_readable; then
        CHECKS_RESULT=unavailable
        print_row checks "not read (gh is not installed or not authenticated)"
        step_done
        return 0
    fi
    if [[ "$kind" == "pr" ]]; then what="PR #$ref"; else what="dev (${ref:0:7})"; fi
    if ! wait_for_ci "$kind" "$ref" "$what"; then
        if [[ "$CHECKS_STOP" == "error" ]]; then
            if [[ "$kind" == "commit" ]]; then
                # --no-pr may run against a remote gh cannot read; go on without it.
                CHECKS_STOP=""
                CHECKS_RESULT=unavailable
                print_warning "could not read the CI runs on $what; merging without them"
                print_output "$CI_READ_ERROR"
                print_row checks "not read"
                step_done
                return 0
            fi
            print_error "could not read the checks of $what"
            print_output "$CI_READ_ERROR"
        fi
        exit 1
    fi
    step_done
}

# Step 2a: Open a PR from dev into base (no merge — the create half of the
# old gh_create_and_merge_pr), or take the release PR an earlier run opened
# (RESUME_PR_NUMBER). Sets RELEASE_PR_NUMBER, RELEASE_PR_URL.
gh_create_pr() {
    local version_tag="$1"
    step_start pr
    if [[ -n "$RESUME_PR_NUMBER" ]]; then
        RELEASE_PR_NUMBER="$RESUME_PR_NUMBER"
        RELEASE_PR_URL=$(gh pr view "$RELEASE_PR_NUMBER" --json url --jq '.url' 2>/dev/null || true)
        print_row pr "#$RELEASE_PR_NUMBER $RELEASE_PR_URL (opened earlier)"
        step_done
        return 0
    fi
    gh_quiet pr create --base "$BASE_BRANCH" --head dev --title "$version_tag" --fill --assignee @me

    # Get most recent open PR number
    RELEASE_PR_NUMBER=$(gh_get_last_open_pr_number)
    if [[ -z "$RELEASE_PR_NUMBER" ]]; then
        print_error "No open pull requests from dev to $BASE_BRANCH found"
        exit 1
    fi
    RELEASE_PR_URL=$(gh pr view "$RELEASE_PR_NUMBER" --json url --jq '.url')

    # Append the note to the PR body, if one was given. --fill already set a
    # commit-derived body; we read it back and append rather than pass --body
    # (which would conflict with --fill). Tolerate gh hiccups so a note failure
    # never aborts the release (set -e).
    if [[ -n "$PR_NOTE" && -n "$RELEASE_PR_NUMBER" ]]; then
        local body
        body=$(gh pr view "$RELEASE_PR_NUMBER" --json body --jq '.body' 2>/dev/null || true)
        if ! quiet_try gh pr edit "$RELEASE_PR_NUMBER" --body "${body}"$'\n\n'"${PR_NOTE}"; then
            print_warning "the --pr-note was not added to PR #$RELEASE_PR_NUMBER; the release continues"
        fi
    fi

    print_row pr "#$RELEASE_PR_NUMBER $RELEASE_PR_URL"
    [[ -n "$PR_NOTE" ]] && print_row_v pr "note: $PR_NOTE"
    # Verbose PR view here (before the merge confirm) so the full flow keeps
    # today's row -> view -> confirm -> merge ordering.
    if [[ $VERBOSE == "true" ]]; then
        gh_quiet pr view "$RELEASE_PR_NUMBER"
    fi
    step_done
}

# Step 2b: Merge the release PR. The full flow passes the PR it just opened;
# the merge phase passes the one release_preflight resolved and checked (open,
# into the base branch, its head at local dev, its title the tag). Waits for the
# PR's checks (the checks step) and stops if any fail, then merges only while
# the PR head is still local dev's head, so a push to dev during the wait is
# not shipped unreviewed.
# The merge commit subject is "version [release]: <version_tag> - PR #<N>".
# Usage: gh_merge_pr <version_tag> <pr_number>
# Sets RELEASE_PR_NUMBER, RELEASE_PR_URL.
gh_merge_pr() {
    local version_tag="$1"
    RELEASE_PR_NUMBER="$2"
    step_start merge
    local dev_head
    dev_head=$(git rev-parse --verify dev)

    wait_for_release_ci pr "$RELEASE_PR_NUMBER"
    step_start merge

    RELEASE_PR_URL=$(gh pr view "$RELEASE_PR_NUMBER" --json url --jq '.url' 2>/dev/null || true)
    confirm_step "2: Merge PR #$RELEASE_PR_NUMBER from dev into $BASE_BRANCH"
    gh_quiet pr merge "$RELEASE_PR_NUMBER" --merge \
        --match-head-commit "$dev_head" \
        --subject "version [release]: $version_tag - PR #$RELEASE_PR_NUMBER" --body ""
    RELEASE_PR_MERGED=true
    git_quiet checkout "$BASE_BRANCH"
    git_quiet pull origin "$BASE_BRANCH"
    print_row merge "#$RELEASE_PR_NUMBER merged into $BASE_BRANCH"
    step_done
}

# Step 2b: Merge dev into main locally (--local, or --no-pr). Always a merge
# commit (--no-ff), so the release carries the same "version [release]" subject
# as a PR merge instead of fast-forwarding the base branch. With --no-pr the
# merge first waits for the CI runs on dev's head, the base branch is brought
# level with origin, and git_tag_version pushes it.
# Tagging is handled by the caller via git_tag_version, after this returns.
git_merge_dev_into_main() {
    local version_tag="$1"
    if ! should_skip_remote; then
        wait_for_release_ci commit "$(git rev-parse dev)"
    fi
    confirm_step "2: Merge dev into $BASE_BRANCH"
    step_start merge
    git_quiet checkout "$BASE_BRANCH"
    local mode="local"
    if ! should_skip_remote; then
        mode="no PR"
        if ! git_quiet pull --ff-only origin "$BASE_BRANCH"; then
            print_error "could not fast-forward $BASE_BRANCH to origin/$BASE_BRANCH" \
                "reconcile $BASE_BRANCH with origin/$BASE_BRANCH, then: git checkout dev && stanza release merge --no-pr"
            exit 1
        fi
    fi
    git_quiet merge dev --no-ff -m "version [release]: $version_tag"
    print_row merge "dev into $BASE_BRANCH ($mode)"
    step_done
}

# True when the release merges through a GitHub PR: remote mode without --no-pr.
release_uses_pr() {
    ! should_skip_remote && [[ "$NO_PR" != "true" ]]
}

# Step 3: Create new prerelease version cycle on dev. Safe to re-run, so a
# 'release merge' re-run can resume it: the merge-back is a no-op once dev has
# the base branch, the bump is skipped once dev is past the release (already on
# a prerelease), and the push is skipped when origin/dev already matches.
create_new_prerelease_cycle() {
    step_start cycle
    confirm_step "3: Create a new version cycle and commit a new prerelease on dev"
    git_quiet checkout dev
    if [[ "$PROJECT_TYPE_DETECTED" != "latex" && "$(get_current_version)" == *a* ]]; then
        DEV_ADVANCED=true  # an earlier run bumped dev; the failure advice must know
    fi

    # Merge base branch into dev to keep histories in sync (includes merge commit from PR)
    if ! should_skip_remote; then
        git_quiet pull origin dev  # Ensure dev is up to date
        git_quiet merge "$BASE_BRANCH" --no-ff --no-edit  # Force merge commit (keeps graph clean)
    else
        # The local release merged dev into the base with --no-ff, so dev is an
        # ancestor: fast-forward it onto the release merge and its tag.
        git_quiet merge "$BASE_BRANCH" --ff-only
    fi

    # LaTeX projects don't have a prerelease concept; skip the version bump
    # but still merge main back so dev stays in sync.
    local outcome="merged $BASE_BRANCH back"
    if [[ "$PROJECT_TYPE_DETECTED" != "latex" ]]; then
        if [[ "$(get_current_version)" == *a* ]]; then
            outcome="already advanced"
        else
            bump_and_commit_version "prerelease"
            print_doc_sync_rows
        fi
        DEV_ADVANCED=true
    fi

    if ! should_skip_remote; then
        if [[ "$(git rev-parse dev)" == "$(git rev-parse -q --verify refs/remotes/origin/dev)" ]]; then
            outcome="$outcome, nothing to push"
        else
            git_quiet push origin dev
            outcome="$outcome, pushed"
        fi
    elif [[ "$PROJECT_TYPE_DETECTED" != "latex" ]]; then
        outcome="$outcome, local"
    fi

    if [[ "$PROJECT_TYPE_DETECTED" == "latex" ]]; then
        print_row cycle "$outcome (latex: no prerelease bump)"
    else
        print_row cycle "$(get_current_version) on dev ($outcome)"
    fi
    step_done
}

# Find a release that an earlier run merged and tagged but did not finish, so
# 'release merge' resumes it instead of looking for a PR. Sets SHIPPED_TAG and
# returns 0 when either:
#   - dev is on a stable version whose tag exists, locally or on origin: the
#     merge and tag are done and the dev cycle is not; or
#   - dev's last commit is the dev-cycle bump that follows its nearest tag: the
#     cycle is done locally and may still need its push.
# Sets SHIPPED_TAG_UNPUSHED=true when only this clone has the tag (a --local
# release finished later against the remote), and fetches it when only origin
# has it. Returns 1 when no such release exists. Part of release_preflight: an
# unreadable or conflicting remote tag, or a failed fetch, is recorded with
# preflight_fail and returns 1.
find_shipped_release() {
    SHIPPED_TAG=""
    SHIPPED_TAG_UNPUSHED=false
    local version tag out
    version=$(get_current_version)

    if [[ "$version" == *a* ]]; then
        [[ "$(git log -1 --format=%s)" == "version [prerelease]: $version" ]] || return 1
        tag=$(git describe --tags --abbrev=0 --match 'v*' HEAD 2>/dev/null) || return 1
        [[ "$(bump_version_string "${tag#v}" prerelease 2>/dev/null)" == "$version" ]] || return 1
    else
        tag="v$version"
    fi

    local local_sha remote_sha=""
    local_sha=$(git rev-parse -q --verify "refs/tags/$tag" 2>/dev/null) || local_sha=""
    if ! should_skip_remote; then
        if ! out=$(git_net ls-remote --tags origin "refs/tags/$tag" 2>&1); then
            preflight_fail "could not read tag $tag from origin" "" "$out"
            return 1
        fi
        remote_sha=$(printf '%s\n' "$out" | awk -v ref="refs/tags/$tag" '$2 == ref { print $1 }')
    fi
    [[ -n "$local_sha" || -n "$remote_sha" ]] || return 1
    if [[ -n "$local_sha" && -n "$remote_sha" && "$local_sha" != "$remote_sha" ]]; then
        preflight_fail "tag $tag differs between this clone and origin" \
            "compare them (git show $tag; git ls-remote origin refs/tags/$tag) and resolve by hand"
        return 1
    fi
    if [[ -z "$local_sha" ]]; then
        # A failed fetch must not resume a release whose tag this clone lacks.
        # --check reports the resume and leaves the fetch to the real run.
        if [[ "$CHECK_ONLY" != "true" ]] && ! out=$(git_net fetch origin "refs/tags/$tag:refs/tags/$tag" 2>&1); then
            preflight_fail "git fetch origin refs/tags/$tag:refs/tags/$tag failed" "" "$out"
            return 1
        fi
    elif ! should_skip_remote && [[ -z "$remote_sha" ]]; then
        SHIPPED_TAG_UNPUSHED=true
    fi
    SHIPPED_TAG="$tag"
}

# Resume a release that find_shipped_release found: bring the base branch level
# with origin (the dev cycle merges it back), check that it carries the tag, and
# push the tag when only this clone has it. A base branch ahead of origin's with
# the tag at its head, as a --local release leaves it, is pushed with the tag
# in one atomic push instead. Sets RELEASE_TAG_NAME and RELEASE_TAG_PUSHED as
# git_tag_version does.
resume_shipped_release() {
    local tag="$1" push_base=false
    step_start tag
    if ! should_skip_remote; then
        git_quiet fetch origin "$BASE_BRANCH"
        local base_sha origin_sha
        base_sha=$(git rev-parse -q --verify "refs/heads/$BASE_BRANCH") || base_sha=""
        origin_sha=$(git rev-parse --verify "refs/remotes/origin/$BASE_BRANCH")
        if [[ -z "$base_sha" ]] || git merge-base --is-ancestor "$base_sha" "$origin_sha"; then
            git_quiet update-ref "refs/heads/$BASE_BRANCH" "$origin_sha"
        elif ! git merge-base --is-ancestor "$origin_sha" "$base_sha"; then
            print_error "$BASE_BRANCH has diverged from origin/$BASE_BRANCH; not resuming" \
                "reconcile them by hand (git log --oneline --left-right $BASE_BRANCH...origin/$BASE_BRANCH shows both sides), then: git checkout dev && stanza release merge"
            exit 1
        elif [[ "$base_sha" != "$(git rev-parse "$tag^{commit}")" ]]; then
            print_error "$BASE_BRANCH has commits after $tag that origin/$BASE_BRANCH lacks; not pushing them with the release" \
                "check them (git log --oneline $tag..$BASE_BRANCH) and push $BASE_BRANCH by hand, then: git checkout dev && stanza release merge"
            exit 1
        else
            push_base=true
        fi
    fi
    if ! git merge-base --is-ancestor "$tag" "$BASE_BRANCH" 2>/dev/null; then
        print_error "tag $tag is not on $BASE_BRANCH; not resuming" \
            "inspect the release by hand: git log --oneline $BASE_BRANCH..$tag"
        exit 1
    fi
    RELEASE_TAG_NAME="$tag"
    if [[ "$push_base" == "true" ]]; then
        # The release merge was made without the remote; push it with its tag,
        # both or neither, as git_tag_version does.
        local refs=("$BASE_BRANCH") push_out
        [[ "$SHIPPED_TAG_UNPUSHED" == "true" ]] && refs+=("refs/tags/$tag")
        if push_out=$(git_net push --atomic origin "${refs[@]}" 2>&1); then
            if [[ "$VERBOSE" == "true" ]]; then printf '%s\n' "$push_out" >&2; fi
        else
            print_error "push of $BASE_BRANCH with the release merge to origin failed; nothing was pushed"
            print_output "$push_out"
            print_hint "retry: git push --atomic origin ${refs[*]}"
            print_hint "or resume once it can be pushed: git checkout dev && stanza release merge"
            exit 1
        fi
        print_row tag "$tag  pushed with $BASE_BRANCH (resumed)"
        RELEASE_TAG_PUSHED=true
    elif [[ "$SHIPPED_TAG_UNPUSHED" == "true" ]]; then
        git_quiet push origin "refs/tags/$tag"
        print_row tag "$tag  pushed (resumed)"
        RELEASE_TAG_PUSHED=true
    else
        print_row tag "$tag  already released; resuming"
        if should_skip_remote; then RELEASE_TAG_PUSHED=false; else RELEASE_TAG_PUSHED=true; fi
    fi
    step_done
}

# Find a release that an earlier run merged into the base branch on origin and
# did not tag: the merge step stopped after gh pr merge succeeded. Called once
# find_shipped_release has found no tag. Fetches the base branch and, when
# dev's head is on it, looks for the merge that put it there: a merge commit
# whose second parent is dev's head. Its tree must be dev's, so the commit
# tagged ships exactly what dev carried. Sets MERGED_RELEASE_COMMIT (and
# SHIPPED_TAG) and returns 0 when found; returns 1 when dev's head is not on
# origin's base branch. Part of release_preflight: a failed fetch, or dev's head
# on the base branch without such a merge, is recorded with preflight_fail.
MERGED_RELEASE_COMMIT=""
find_merged_release() {
    local tag="$1" out dev_head commit
    MERGED_RELEASE_COMMIT=""
    should_skip_remote && return 1
    if ! out=$(git_net fetch origin "$BASE_BRANCH" 2>&1); then
        preflight_fail "Could not fetch from origin/$BASE_BRANCH" "" "$out"
        return 1
    fi
    dev_head=$(git rev-parse dev)
    git merge-base --is-ancestor "$dev_head" "origin/$BASE_BRANCH" || return 1
    # The earliest merge of dev's head on the way to origin's base branch.
    commit=$(git rev-list --merges --parents --reverse --ancestry-path \
        "$dev_head..origin/$BASE_BRANCH" | awk -v d="$dev_head" '$3 == d { print $1; exit }')
    if [[ -z "$commit" ]]; then
        preflight_fail "dev's head is on origin/$BASE_BRANCH, but not through a merge commit; not tagging it" \
            "find the release commit (git log --oneline origin/$BASE_BRANCH) and tag it by hand: git tag $tag <commit> && git push origin refs/tags/$tag"
        return 1
    fi
    if [[ "$(git rev-parse "$commit^{tree}")" != "$(git rev-parse "$dev_head^{tree}")" ]]; then
        preflight_fail "the merge of dev into $BASE_BRANCH (${commit:0:7}) differs from dev's tree; not tagging it" \
            "compare them (git diff dev ${commit:0:7}), then tag by hand: git tag $tag ${commit:0:7} && git push origin refs/tags/$tag"
        return 1
    fi
    # git_tag_version pushes the base branch with the tag: it must carry
    # nothing origin's lacks.
    local base_sha
    base_sha=$(git rev-parse -q --verify "refs/heads/$BASE_BRANCH") || base_sha=""
    if [[ -n "$base_sha" ]] && ! git merge-base --is-ancestor "$base_sha" "origin/$BASE_BRANCH"; then
        preflight_fail "$BASE_BRANCH has commits that origin/$BASE_BRANCH lacks; not pushing them with $tag" \
            "check them (git log --oneline origin/$BASE_BRANCH..$BASE_BRANCH), push or drop them by hand, then: git checkout dev && stanza release merge"
        return 1
    fi
    MERGED_RELEASE_COMMIT="$commit"
    SHIPPED_TAG="$tag"
}

# Resume a release that find_merged_release found: fast-forward the base branch
# to origin's, which find_merged_release fetched and which carries the merge, so
# git_tag_version can push it with the tag. Sets RELEASE_PR_NUMBER (and
# RELEASE_PR_URL) when the merge subject names the PR.
resume_merged_release() {
    local commit="$1" subject re=' - PR #([0-9]+)$'
    step_start merge
    RELEASE_PR_MERGED=true
    subject=$(git log -1 --format=%s "$commit")
    if [[ "$subject" =~ $re ]]; then
        RELEASE_PR_NUMBER="${BASH_REMATCH[1]}"
        RELEASE_PR_URL=$(gh pr view "$RELEASE_PR_NUMBER" --json url --jq '.url' 2>/dev/null || true)
    fi
    git_quiet checkout "$BASE_BRANCH"
    git_quiet merge --ff-only "origin/$BASE_BRANCH"
    print_row merge "${RELEASE_PR_NUMBER:+#$RELEASE_PR_NUMBER }merged into $BASE_BRANCH earlier (${commit:0:7}); resuming"
    step_done
}

# Step 3 (gated): run the new prerelease cycle unless --no-dev-cycle was
# given. When skipped, dev is left untouched (no merge-back, no bump) and the
# caller stays on the base branch; NEW_DEV_VERSION is cleared so JSON emits null.
run_prerelease_cycle_or_skip() {
    if [[ "$NO_DEV_PRERELEASE" == "true" ]]; then
        print_row cycle "skipped (--no-dev-cycle); now on $BASE_BRANCH, dev unchanged"
        print_hint "dev was not advanced; merge $BASE_BRANCH back and bump when ready"
        NEW_DEV_VERSION=""
    else
        create_new_prerelease_cycle
        NEW_DEV_VERSION=$(get_current_version)
    fi
}

# Append the "pr" JSON field: an object with number/url (and note, when a
# --pr-note was given), or null when no PR was opened (e.g. --local). The note
# key is present only when set, so the unchanged full-release path emits the
# same pr object as before.
json_set_pr_field() {
    if [[ -n "$RELEASE_PR_NUMBER" ]]; then
        local obj
        obj="{\"number\":$RELEASE_PR_NUMBER,\"url\":\"$(json_escape "$RELEASE_PR_URL")\""
        if [[ -n "$PR_NOTE" ]]; then
            obj="${obj},\"note\":\"$(json_escape "$PR_NOTE")\""
        fi
        obj="${obj}}"
        json_set_raw pr "$obj"
    else
        json_set_raw pr "null"
    fi
}

# ------------------------------------------------------------------------------
# Preflight
#
# release_preflight checks everything a phase needs before the run commits,
# pushes, merges, or tags anything, so a release that could not finish stops
# with nothing changed. A failed check is recorded with preflight_fail instead
# of exiting, and preflight_report prints every failure at once. A check whose
# input an earlier failure leaves unknown is skipped: the version on the wrong
# branch, the PR when gh is not authenticated.

# Record a failed check: the error, its hints (newline-separated), and the
# output of the command that failed, printed under the error.
# Usage: preflight_fail <error> [hints] [output]
preflight_fail() {
    PREFLIGHT_ERRORS+=("$1")
    PREFLIGHT_HINTS+=("${2:-}")
    PREFLIGHT_OUTPUT+=("${3:-}")
}

# Print every recorded failure with its output and hints, then exit 1. Returns
# when nothing failed.
preflight_report() {
    [[ ${#PREFLIGHT_ERRORS[@]} -eq 0 ]] && return 0
    local i hint
    for ((i = 0; i < ${#PREFLIGHT_ERRORS[@]}; i++)); do
        print_error "${PREFLIGHT_ERRORS[i]}"
        print_output "${PREFLIGHT_OUTPUT[i]}"
        while IFS= read -r hint; do
            [[ -n "$hint" ]] && print_hint "$hint"
        done <<< "${PREFLIGHT_HINTS[i]}"
    done
    exit 1
}

# Succeed when version $1 sorts below version $2. Both are semver with an
# optional alpha suffix or LaTeX versions of 1 to 3 components: a missing
# component counts as 0, and a prerelease sorts below its release.
version_lt() {
    local a_pre="" b_pre="" i x y
    [[ "$1" == *a* ]] && a_pre="${1#*a}"
    [[ "$2" == *a* ]] && b_pre="${2#*a}"
    local IFS=.
    local a b
    read -r -a a <<< "${1%%a*}"
    read -r -a b <<< "${2%%a*}"
    for i in 0 1 2; do
        x=$((10#${a[i]:-0}))
        y=$((10#${b[i]:-0}))
        if [[ $x -lt $y ]]; then return 0; fi
        if [[ $x -gt $y ]]; then return 1; fi
    done
    [[ -n "$a_pre" ]] || return 1
    [[ -z "$b_pre" ]] && return 0
    [[ $((10#$a_pre)) -lt $((10#$b_pre)) ]]
}

# Print the highest version tag among tag names on stdin, one per line; a tag
# counts when it is v followed by a version of the project's form: LaTeX for
# <project_type> latex, semver otherwise, so a floating major tag (v1) or a
# date tag does not count in a semver project. Prints nothing when none does.
# Usage: latest_version_tag <project_type>
latest_version_tag() {
    local tag best="" valid=is_valid_version_string
    [[ "$1" == "latex" ]] && valid=is_valid_latex_version_string
    while IFS= read -r tag; do
        [[ "$tag" == v* ]] || continue
        tag="${tag#v}"
        "$valid" "$tag" || continue
        if [[ -z "$best" ]] || version_lt "$best" "$tag"; then
            best="$tag"
        fi
    done
    if [[ -n "$best" ]]; then echo "v$best"; fi
}

# Record a failure unless <branch> is level with origin/<branch>, after
# fetching it. With ahead_ok true, a branch only ahead of origin's passes too.
# Usage: preflight_branch_level <branch> [ahead_ok]
preflight_branch_level() {
    local branch="$1" ahead_ok="${2:-false}" out counts ahead behind hint
    if ! out=$(git_net fetch origin "$branch" 2>&1); then
        preflight_fail "Could not fetch from origin/$branch" "" "$out"
        return 0
    fi
    counts=$(git rev-list --left-right --count "$branch...origin/$branch" 2>/dev/null) || counts="0 0"
    read -r ahead behind <<< "$counts"
    if [[ "$behind" -eq 0 && ( "$ahead" -eq 0 || "$ahead_ok" == "true" ) ]]; then
        return 0
    fi
    if [[ "$behind" -eq 0 ]]; then
        hint="push it first: git push origin $branch"
    elif [[ "$ahead" -eq 0 ]]; then
        hint="pull first: git pull origin $branch"
    else
        hint="reconcile them first: git pull --rebase origin $branch"
    fi
    preflight_fail "$branch is not level with origin/$branch ($ahead ahead, $behind behind)" "$hint"
}

# For a merge without a PR: record a failure when the local base branch and
# origin's have diverged, after fetching it. The merge step pulls the base with
# --ff-only, which would refuse only after the bump is pushed. A clone with no
# local base branch passes: the checkout creates it from origin's.
preflight_base_fast_forward() {
    local out
    git rev-parse -q --verify "refs/heads/$BASE_BRANCH" >/dev/null || return 0
    if ! out=$(git_net fetch origin "$BASE_BRANCH" 2>&1); then
        preflight_fail "Could not fetch from origin/$BASE_BRANCH" "" "$out"
        return 0
    fi
    if git merge-base --is-ancestor "origin/$BASE_BRANCH" "$BASE_BRANCH" ||
        git merge-base --is-ancestor "$BASE_BRANCH" "origin/$BASE_BRANCH"; then
        return 0
    fi
    preflight_fail "$BASE_BRANCH has diverged from origin/$BASE_BRANCH; the merge without a PR cannot fast-forward it" \
        "reconcile them first (git log --oneline --left-right $BASE_BRANCH...origin/$BASE_BRANCH shows both sides)"
}

# Read the base branch and the version tags on origin in one call into
# REMOTE_TAGS (tag names, one per line). Records a failure when origin cannot
# be read, or, for a release that merges into it, has no base branch, or (for
# a merge without a PR) a base branch the local one has diverged from.
REMOTE_TAGS=""
preflight_remote_refs() {
    local out
    REMOTE_TAGS=""
    if ! out=$(git_net ls-remote origin "refs/heads/$BASE_BRANCH" 'refs/tags/v*' 2>&1); then
        preflight_fail "could not read the branches and tags on origin" "" "$out"
        return 0
    fi
    REMOTE_TAGS=$(printf '%s\n' "$out" | awk '$2 ~ /^refs\/tags\// && $2 !~ /\^\{\}$/ { sub(/^refs\/tags\//, "", $2); print $2 }')
    [[ "$BUMP_TYPE" == "prerelease" ]] && return 0
    if ! printf '%s\n' "$out" | awk -v ref="refs/heads/$BASE_BRANCH" '$2 == ref { found = 1 } END { exit !found }'; then
        preflight_fail "origin has no $BASE_BRANCH branch to release into" \
            "push it first: git push -u origin $BASE_BRANCH"
    elif [[ "$NO_PR" == "true" && "$PHASE" != "pr" ]]; then
        preflight_base_fast_forward
    fi
}

# For 'release merge' through a PR: resolve the PR (the pinned number, or the
# one open dev->base PR) into MERGE_PR_NUMBER, and check that merging it ships
# this release: it is open, targets the base branch, its head is local dev's
# head (so no unreviewed commit rides along), and its title is the tag.
preflight_merge_pr() {
    local tag="$1" pr="$MERGE_PR_NUMBER" count info head base state title dev_head
    if [[ -z "$pr" ]]; then
        count=$(gh pr list --base "$BASE_BRANCH" --head dev --state open --json number --jq 'length' 2>/dev/null || echo 0)
        if [[ "$count" -gt 1 ]]; then
            preflight_fail "Multiple open dev->$BASE_BRANCH PRs ($count); target is ambiguous" \
                "pin one: stanza release merge <pr-number>"
            return 0
        fi
        pr=$(gh_get_last_open_pr_number 2>/dev/null) || pr=""
        if [[ -z "$pr" ]]; then
            preflight_fail "No open PR from dev to $BASE_BRANCH to merge" \
                "run 'stanza release pr <type>' first"
            return 0
        fi
    fi
    MERGE_PR_NUMBER="$pr"

    info=$(gh pr view "$pr" --json headRefOid,baseRefName,state \
        --jq '[.headRefOid, .baseRefName, .state] | join("|")' 2>/dev/null) || info=""
    IFS='|' read -r head base state <<< "$info"
    dev_head=$(git rev-parse -q --verify dev 2>/dev/null) || dev_head=""
    if [[ -z "$head" || -z "$dev_head" ]]; then
        preflight_fail "Could not verify PR #$pr head against dev" \
            "check GitHub access and the local dev branch, then retry"
        return 0
    fi
    if [[ "$state" != "OPEN" || "$base" != "$BASE_BRANCH" ]]; then
        preflight_fail "PR #$pr must be OPEN and target $BASE_BRANCH" \
            "select the open release PR from dev to $BASE_BRANCH"
    elif [[ "$head" != "$dev_head" ]]; then
        preflight_fail "dev has advanced past PR #$pr head; merge would ship unreviewed commits" \
            "re-run 'stanza release pr <type>' to refresh the PR"
    fi
    title=$(gh pr view "$pr" --json title --jq '.title' 2>/dev/null) || title=""
    if [[ "$title" != "$tag" ]]; then
        preflight_fail "PR #$pr title does not match $tag" \
            "PR title must be the release tag: $tag"
    fi
}

# Find a stable bump that an earlier 'release <type>' or 'release pr <type>'
# run committed on dev and did not release: dev's last commit is the bump to
# the version dev is on, and that version is tagged neither in this clone nor
# on origin. The run then resumes at the push and the PR instead of bumping
# again. Sets BUMP_RESUMED_TYPE to the bump's type and returns 0 when found.
# Part of release_preflight: an unreadable origin is recorded with
# preflight_fail and returns 1.
BUMP_RESUMED_TYPE=""
find_unfinished_bump() {
    local subject out re='^version \[(patch|minor|major)\]: (.+)$'
    BUMP_RESUMED_TYPE=""
    subject=$(git log -1 --format=%s 2>/dev/null) || return 1
    [[ "$subject" =~ $re ]] || return 1
    [[ "${BASH_REMATCH[2]}" == "$CURRENT_VERSION" ]] || return 1
    BUMP_RESUMED_TYPE="${BASH_REMATCH[1]}"
    if git rev-parse -q --verify "refs/tags/v$CURRENT_VERSION" >/dev/null; then
        BUMP_RESUMED_TYPE=""
        return 1
    fi
    if ! should_skip_remote; then
        if ! out=$(git_net ls-remote --tags origin "refs/tags/v$CURRENT_VERSION" 2>&1); then
            BUMP_RESUMED_TYPE=""
            preflight_fail "could not read tag v$CURRENT_VERSION from origin" "" "$out"
            return 1
        fi
        if [[ -n "$out" ]]; then
            BUMP_RESUMED_TYPE=""
            return 1
        fi
    fi
}

# For a run that resumes an unfinished bump against the remote: record a
# failure when dev's head is already merged into origin's base branch, which the
# merge phase finishes. Through a PR, also take the release PR an earlier run
# opened into RESUME_PR_NUMBER, after checking that its title is the tag.
# Usage: preflight_resumed_bump <tag> <gh_ok>
RESUME_PR_NUMBER=""
preflight_resumed_bump() {
    local tag="$1" gh_ok="$2" out pr title merge_cmd="stanza release merge"
    should_skip_remote && return 0
    [[ "$NO_PR" == "true" ]] && merge_cmd="$merge_cmd --no-pr"
    if ! out=$(git_net fetch origin "$BASE_BRANCH" 2>&1); then
        preflight_fail "Could not fetch from origin/$BASE_BRANCH" "" "$out"
        return 0
    fi
    if git merge-base --is-ancestor dev "origin/$BASE_BRANCH"; then
        preflight_fail "$tag is already merged into $BASE_BRANCH, untagged" \
            "finish it: $merge_cmd"
        return 0
    fi
    release_uses_pr || return 0
    [[ "$gh_ok" == "true" ]] || return 0
    pr=$(gh_get_last_open_pr_number 2>/dev/null) || pr=""
    [[ -n "$pr" ]] || return 0
    title=$(gh pr view "$pr" --json title --jq '.title' 2>/dev/null) || title=""
    if [[ "$title" != "$tag" ]]; then
        preflight_fail "PR #$pr is open from dev to $BASE_BRANCH with the title '$title', not $tag" \
            "close it, or retitle it $tag, then re-run"
        return 0
    fi
    RESUME_PR_NUMBER="$pr"
}

# Run every check the phase needs and report the failures together (exit 1),
# or return when the release can go ahead. Sets RELEASE_TARGET, the version
# the run ships; for full and pr, BUMP_RESUMED when dev carries an unfinished
# bump (find_unfinished_bump); for merge, RELEASE_RESUMED and SHIPPED_TAG when
# an earlier run merged the release (find_shipped_release,
# find_merged_release), and MERGE_PR_NUMBER.
RELEASE_TARGET=""
RELEASE_RESUMED=false
BUMP_RESUMED=false
release_preflight() {
    local on_branch=true gh_ok=true tag="" tags latest where errors_before

    # The branch and the working tree
    if [[ "$BUMP_TYPE" == "prerelease" ]]; then
        if [[ "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "master" ]]; then
            preflight_fail "Prerelease versions cannot be bumped on protected branch: $CURRENT_BRANCH" \
                "switch to a development or feature branch"
            on_branch=false
        fi
    elif [[ "$CURRENT_BRANCH" != "dev" ]]; then
        preflight_fail "This operation should be performed on dev branch" \
            "current branch is ${CURRENT_BRANCH:-a detached HEAD}: git checkout dev"
        on_branch=false
    fi
    if has_uncommitted_changes; then
        preflight_fail "Uncommitted changes, commit or stash them first." "" "$(git status --porcelain)"
    fi

    # gh, which the PR path calls for the PR, its checks, and the merge
    if [[ "$BUMP_TYPE" != "prerelease" ]] && release_uses_pr && ! gh auth status >/dev/null 2>&1; then
        gh_ok=false
        preflight_fail "GitHub CLI is not authenticated" \
            "authenticate: gh auth login"$'\n'"or release without GitHub: stanza release $CMD_LABEL --local"
    fi

    # The version the run ships, read from the branch it runs on
    if [[ "$on_branch" == "true" ]]; then
        if [[ "$BUMP_TYPE" == "prerelease" && "$PROJECT_TYPE_DETECTED" == "latex" ]]; then
            preflight_fail "LaTeX projects don't support prerelease bumps" \
                "use 'stanza release patch|minor|major' instead"
        elif [[ "$PROJECT_TYPE_DETECTED" == "latex" ]] && ! is_valid_latex_version_string "$CURRENT_VERSION"; then
            preflight_fail "Invalid LaTeX version string: $CURRENT_VERSION"
        elif [[ "$PROJECT_TYPE_DETECTED" != "latex" ]] && ! is_valid_version_string "$CURRENT_VERSION"; then
            preflight_fail "Invalid version string: $CURRENT_VERSION" \
                "versions are major.minor.patch with an optional aN suffix, without leading zeros"
        elif [[ "$PHASE" == "merge" ]]; then
            RELEASE_TARGET="$CURRENT_VERSION"
        elif [[ "$BUMP_TYPE" != "prerelease" ]] && find_unfinished_bump; then
            RELEASE_TARGET="$CURRENT_VERSION"
            BUMP_RESUMED=true
            if [[ "$BUMP_RESUMED_TYPE" != "$BUMP_TYPE" ]]; then
                local resume_label="$BUMP_RESUMED_TYPE"
                [[ "$PHASE" == "pr" ]] && resume_label="pr $resume_label"
                [[ "$YES_TO_ALL" == "true" ]] && resume_label="$resume_label -y"
                preflight_fail "dev already carries an unreleased $BUMP_RESUMED_TYPE bump to $CURRENT_VERSION; not bumping again" \
                    "resume it: stanza release $resume_label"$'\n'"or, to release another version, remove that bump commit from dev first"
            fi
        elif [[ "$PROJECT_TYPE_DETECTED" == "latex" ]]; then
            RELEASE_TARGET=$(bump_latex_version_string "$CURRENT_VERSION" "$BUMP_TYPE")
        else
            RELEASE_TARGET=$(bump_version_string "$CURRENT_VERSION" "$BUMP_TYPE")
        fi
    fi
    if [[ -n "$RELEASE_TARGET" ]]; then
        tag="v$RELEASE_TARGET"
    fi

    # merge: a release an earlier run merged and tagged, or merged on origin
    # without tagging, is resumed instead, and needs nothing below. A failure
    # to tell leaves the rest unknown.
    if [[ "$PHASE" == "merge" && -n "$tag" ]]; then
        errors_before=${#PREFLIGHT_ERRORS[@]}
        if find_shipped_release; then
            RELEASE_RESUMED=true
        elif [[ ${#PREFLIGHT_ERRORS[@]} -eq $errors_before && "$RELEASE_TARGET" != *a* ]] &&
            find_merged_release "$tag"; then
            RELEASE_RESUMED=true
        fi
        if [[ "$RELEASE_RESUMED" == "true" || ${#PREFLIGHT_ERRORS[@]} -gt $errors_before ]]; then
            preflight_report
            return 0
        fi
    fi

    # The branch the run pushes is level with origin. A merge through a PR
    # checks the PR's head against dev instead.
    if ! should_skip_remote; then
        if [[ "$BUMP_TYPE" == "prerelease" ]]; then
            if [[ -n "$CURRENT_BRANCH" ]]; then
                preflight_branch_level "$CURRENT_BRANCH"
            fi
        elif [[ "$PHASE" != "merge" ]] || ! release_uses_pr; then
            # A resumed bump may not be pushed yet.
            preflight_branch_level dev "$BUMP_RESUMED"
        fi
    fi

    # full and pr: what the stable bump needs, or what resuming one needs
    if [[ "$BUMP_RESUMED" == "true" ]]; then
        preflight_resumed_bump "$tag" "$gh_ok"
    elif [[ "$BUMP_TYPE" != "prerelease" && "$PHASE" != "merge" ]]; then
        if [[ "$on_branch" == "true" && "$NO_CHANGELOG" != "true" &&
            "$(changelog_unreleased_status)" == "empty" ]]; then
            preflight_fail "CHANGELOG.md [Unreleased] is empty; add entries before releasing" \
                "fill ## [Unreleased], or pass --no-changelog to skip changelog promotion"
        fi
        if [[ "$on_branch" == "true" && "$gh_ok" == "true" ]]; then
            check_dev_ci_before_bump
        fi
    fi

    # merge: what it merges
    if [[ "$PHASE" == "merge" && -n "$tag" ]]; then
        if release_uses_pr; then
            if [[ "$gh_ok" == "true" ]]; then
                preflight_merge_pr "$tag"
            fi
        elif [[ "$RELEASE_TARGET" == *a* ]]; then
            # A direct merge cannot tell whether a pr phase promoted the version.
            preflight_fail "refusing to tag a prerelease (alpha) on $BASE_BRANCH" \
                "promote first (stanza release pr patch) or run a full release"
        fi
    fi

    # The tag: free in this clone and on origin, and above the latest version
    # tag in either. A prerelease is not tagged, but must still sort above the
    # last one.
    if [[ -n "$tag" ]]; then
        tags=$(git tag -l 'v*')
        where=""
        if printf '%s\n' "$tags" | grep -qxF "$tag"; then
            where="in this clone"
        fi
        if ! should_skip_remote; then
            preflight_remote_refs
            tags="$tags"$'\n'"$REMOTE_TAGS"
            if printf '%s\n' "$REMOTE_TAGS" | grep -qxF "$tag"; then
                where="${where:+$where and }on origin"
            fi
        fi
        if [[ "$BUMP_TYPE" != "prerelease" && -n "$where" ]]; then
            preflight_fail "tag $tag already exists $where" \
                "inspect it (git show $tag); release a higher version, or delete the tag if it is stale"
        fi
        latest=$(printf '%s\n' "$tags" | latest_version_tag "$PROJECT_TYPE_DETECTED")
        if [[ -n "$latest" ]] && version_lt "$RELEASE_TARGET" "${latest#v}"; then
            preflight_fail "$tag is lower than the latest tag $latest" \
                "set dev's version above ${latest#v} first"
        fi
    fi

    preflight_report
}

# --check: report that the release can go ahead and what it would do.
report_check_passed() {
    local summary
    if [[ -n "$MERGED_RELEASE_COMMIT" ]]; then
        summary="would resume $SHIPPED_TAG: tag its merge ${MERGED_RELEASE_COMMIT:0:7} on $BASE_BRANCH"
    elif [[ "$RELEASE_RESUMED" == "true" ]]; then
        summary="would resume $SHIPPED_TAG"
    elif [[ "$BUMP_TYPE" == "prerelease" ]]; then
        summary="would bump $CURRENT_VERSION -> $RELEASE_TARGET on $CURRENT_BRANCH"
    elif [[ "$PHASE" == "merge" ]]; then
        summary="would merge and tag v$RELEASE_TARGET"
        [[ -n "$MERGE_PR_NUMBER" ]] && summary="$summary from PR #$MERGE_PR_NUMBER"
    elif [[ "$BUMP_RESUMED" == "true" ]]; then
        summary="would resume the $BUMP_TYPE bump to $RELEASE_TARGET already on dev"
        if [[ -n "$RESUME_PR_NUMBER" ]]; then
            summary="$summary, with PR #$RESUME_PR_NUMBER"
        elif [[ "$PHASE" == "pr" ]] && ! should_skip_remote; then
            summary="$summary and open its PR"
        fi
        [[ "$PHASE" == "full" ]] && summary="$summary, and release v$RELEASE_TARGET"
    elif [[ "$PHASE" == "pr" ]]; then
        summary="would bump $CURRENT_VERSION -> $RELEASE_TARGET and open its PR"
    else
        summary="would release $CURRENT_VERSION -> v$RELEASE_TARGET"
    fi
    print_row check "passed; $summary"

    json_set command "release"
    [[ "$PHASE" != "full" ]] && json_set phase "$PHASE"
    json_set_raw ok true
    json_set_raw check true
    json_set_or_null bump_type "$BUMP_TYPE"
    json_set project_type "$PROJECT_TYPE_DETECTED"
    json_set from_version "$CURRENT_VERSION"
    if [[ "$RELEASE_RESUMED" == "true" ]]; then
        json_set to_version "${SHIPPED_TAG#v}"
        json_set tag "$SHIPPED_TAG"
    else
        json_set to_version "$RELEASE_TARGET"
        if [[ "$BUMP_TYPE" == "prerelease" ]]; then
            json_set_raw tag null
        else
            json_set tag "v$RELEASE_TARGET"
        fi
    fi
    if [[ "$PHASE" == "merge" ]]; then
        json_set_raw resumed "$RELEASE_RESUMED"
        json_set_raw pr "${MERGE_PR_NUMBER:-null}"
    elif [[ "$BUMP_TYPE" != "prerelease" ]]; then
        json_set_raw resumed "$BUMP_RESUMED"
    fi
    json_emit
    print_done "preflight passed; nothing changed"
}

# Prerequisites checks. gh is needed only where the PR path calls it, the
# same condition as the auth check in release_preflight.
if [[ "$BUMP_TYPE" != "prerelease" ]] && release_uses_pr; then
    check_required_commands
else
    check_required_commands --without-gh
fi
check_git_remote_status

RELEASE_PR_NUMBER=""
RELEASE_PR_URL=""

release_preflight
if [[ "$CHECK_ONLY" == "true" ]]; then
    report_check_passed
    exit 0
fi

if [[ "$BUMP_TYPE" == "prerelease" ]]; then
    handle_prerelease_workflow
fi

case "$PHASE" in
    full)
        # Unchanged one-shot flow: bump on dev, open+merge the PR (or merge
        # locally), tag, then open the next prerelease cycle.
        create_version_bump_on_dev
        version_tag="v$(get_current_version)"
        RELEASE_VERSION=$(get_current_version)
        if release_uses_pr; then
            gh_create_pr "$version_tag"
            gh_merge_pr "$version_tag" "$RELEASE_PR_NUMBER"
        else
            git_merge_dev_into_main "$version_tag"
        fi
        git_tag_version "$version_tag"
        run_prerelease_cycle_or_skip

        # JSON output (stdout, suppresses human banner via JSON_OUTPUT gating)
        json_set command "release"
        json_set_raw ok true
        json_set_raw resumed "$BUMP_RESUMED"
        json_set bump_type "$BUMP_TYPE"
        json_set project_type "$PROJECT_TYPE_DETECTED"
        json_set_or_null from_version "$RELEASE_FROM_VERSION"
        json_set to_version "$RELEASE_TO_VERSION"
        json_set branch_from "dev"
        json_set branch_to "$BASE_BRANCH"
        json_set commit "$RELEASE_COMMIT_SHA"
        json_set_raw pushed "$RELEASE_PUSHED"
        json_set_pr_field
        json_set_or_null checks "$CHECKS_RESULT"
        json_set_raw tag "{\"name\":\"$(json_escape "$RELEASE_TAG_NAME")\",\"pushed\":$RELEASE_TAG_PUSHED}"
        json_set_or_null next_cycle_version "$NEW_DEV_VERSION"
        json_set_raw readme_synced "$RELEASE_README_SYNCED"
        json_set_raw changelog_promoted "$RELEASE_CHANGELOG_PROMOTED"
        json_emit

        if [[ "$VERBOSITY" -le 0 ]]; then
            if [[ "$JSON_OUTPUT" != "true" ]]; then
                echo "$RELEASE_VERSION"
            fi
        elif [[ "$NO_DEV_PRERELEASE" == "true" ]]; then
            print_done "released $version_tag; dev prerelease cycle skipped"
        else
            print_done "released $version_tag; dev -> $NEW_DEV_VERSION"
        fi
        ;;

    pr)
        # Phase 1: bump on dev and open the PR, then stop for review.
        [[ "$NO_DEV_PRERELEASE" == "true" ]] && \
            print_row_v note "--no-dev-cycle has no effect on 'pr'; pass it to 'merge'"
        create_version_bump_on_dev
        version_tag="v$(get_current_version)"
        RELEASE_VERSION=$(get_current_version)
        if ! should_skip_remote; then
            gh_create_pr "$version_tag"
        fi

        json_set command "release"
        json_set phase "pr"
        json_set_raw ok true
        json_set_raw resumed "$BUMP_RESUMED"
        json_set bump_type "$BUMP_TYPE"
        json_set project_type "$PROJECT_TYPE_DETECTED"
        json_set_or_null from_version "$RELEASE_FROM_VERSION"
        json_set to_version "$RELEASE_TO_VERSION"
        json_set branch_from "dev"
        json_set branch_to "$BASE_BRANCH"
        json_set commit "$RELEASE_COMMIT_SHA"
        json_set_raw pushed "$RELEASE_PUSHED"
        json_set_pr_field
        json_set resume "stanza release merge"
        json_set_raw readme_synced "$RELEASE_README_SYNCED"
        json_set_raw changelog_promoted "$RELEASE_CHANGELOG_PROMOTED"
        json_emit

        print_hint "review the PR, then: stanza release merge"
        if [[ "$VERBOSITY" -le 0 ]]; then
            if [[ "$JSON_OUTPUT" != "true" ]]; then
                echo "$RELEASE_VERSION"
            fi
        else
            print_done "$version_tag opened on dev; review, then: stanza release merge"
        fi
        ;;

    merge)
        # Phase 2: merge the open PR (or merge dev directly), tag, new cycle.
        if [[ -n "$MERGED_RELEASE_COMMIT" ]]; then
            # An earlier run merged this release on origin and stopped before
            # tagging it: tag that merge, then the dev cycle.
            version_tag="$SHIPPED_TAG"
            resume_merged_release "$MERGED_RELEASE_COMMIT"
            git_tag_version "$version_tag" "$MERGED_RELEASE_COMMIT"
        elif [[ "$RELEASE_RESUMED" == "true" ]]; then
            # An earlier run merged and tagged this release and stopped before
            # finishing: skip to the tag push and the dev cycle.
            version_tag="$SHIPPED_TAG"
            resume_shipped_release "$version_tag"
        else
            version_tag="v$RELEASE_TARGET"
            if release_uses_pr; then
                gh_merge_pr "$version_tag" "$MERGE_PR_NUMBER"
            else
                git_merge_dev_into_main "$version_tag"
            fi
            git_tag_version "$version_tag"
        fi
        run_prerelease_cycle_or_skip
        RELEASE_VERSION="${version_tag#v}"

        json_set command "release"
        json_set phase "merge"
        json_set_raw ok true
        json_set_raw resumed "$RELEASE_RESUMED"
        json_set project_type "$PROJECT_TYPE_DETECTED"
        json_set branch_from "dev"
        json_set branch_to "$BASE_BRANCH"
        json_set_pr_field
        json_set_or_null checks "$CHECKS_RESULT"
        json_set_raw tag "{\"name\":\"$(json_escape "$RELEASE_TAG_NAME")\",\"pushed\":$RELEASE_TAG_PUSHED}"
        json_set_or_null next_cycle_version "$NEW_DEV_VERSION"
        json_set_raw readme_synced "$RELEASE_README_SYNCED"
        json_set_raw changelog_promoted "$RELEASE_CHANGELOG_PROMOTED"
        json_emit

        if [[ "$VERBOSITY" -le 0 ]]; then
            if [[ "$JSON_OUTPUT" != "true" ]]; then
                echo "$RELEASE_VERSION"
            fi
        elif [[ "$NO_DEV_PRERELEASE" == "true" ]]; then
            print_done "released $version_tag; dev prerelease cycle skipped"
        elif [[ "$RELEASE_RESUMED" == "true" ]]; then
            print_done "resumed $version_tag; dev -> $NEW_DEV_VERSION"
        else
            print_done "released $version_tag; dev -> $NEW_DEV_VERSION"
        fi
        ;;
esac
