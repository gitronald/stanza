#!/usr/bin/env bash
# Print, install, check, or remove the generated Claude Code rule that
# documents stanza's commit contract (~/.claude/rules/stanza.md, or
# <repo>/.claude/rules/stanza.md with --local)
set -e

# Source shared utilities
source "$(dirname "${BASH_SOURCE[0]:-$0}")/stanza-common"

RULES_SOURCE="$STANZA_LIB_DIR/stanza-rules.md"
RULES_MARKER="generated by stanza"

# Default values
RULES_ACTION="print"   # print | install | check | uninstall
RULES_LOCAL=false
RULES_FORCE=false
HELP=false

print_rules_help() {
    cat <<'EOF'
Print, install, or check the generated Claude Code rule for stanza

Usage:
  stanza rules                              Print the rule text
  stanza rules install [--local] [--force]  Write the rule file
  stanza rules check                        Compare installed rule files to this version
  stanza rules uninstall [--local]          Remove a rule file stanza generated

Locations:
  global (default)  ~/.claude/rules/stanza.md
  local (--local)   <repo>/.claude/rules/stanza.md

Options:
      --local      Target the current repo instead of ~/.claude
      --force      Overwrite a file stanza did not generate (install only)
  -q, --quiet      Reduce output to one-line outcomes (errors still print)
      --json       Emit a single JSON document on stdout
      --no-color   Disable ANSI color (also honors NO_COLOR env)
  -h, --help       Print help
EOF
}

# Leading action token
case "${1:-}" in
    install|check|uninstall) RULES_ACTION="$1"; shift ;;
esac

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --local)
            RULES_LOCAL=true
            shift
            ;;
        --force)
            RULES_FORCE=true
            shift
            ;;
        -q|--quiet)
            QUIET_REQUESTED=true
            VERBOSITY=0
            shift
            ;;
        --json)
            JSON_OUTPUT=true
            shift
            ;;
        --no-color)
            NO_COLOR_OVERRIDE=true
            shift
            ;;
        -h|--help)
            HELP=true
            shift
            ;;
        *)
            print_error "Unknown option '$1'"
            echo "Use -h or --help for usage information"
            exit 1
            ;;
    esac
done

check_verbosity_exclusion

if [[ $HELP == true ]]; then
    print_rules_help
    exit 0
fi

if [[ "$RULES_FORCE" == "true" && "$RULES_ACTION" != "install" ]]; then
    print_error "--force applies only to 'rules install'"
    exit 1
fi
if [[ "$RULES_LOCAL" == "true" && "$RULES_ACTION" != "install" && "$RULES_ACTION" != "uninstall" ]]; then
    print_error "--local applies only to 'rules install' and 'rules uninstall'" \
        "'rules check' already reports both locations"
    exit 1
fi

if [[ ! -f "$RULES_SOURCE" ]]; then
    print_error "rule text not found at $RULES_SOURCE"
    exit 1
fi

# Path of the rule file for a scope (global | local). Local resolves against
# the enclosing git repo; returns 1 outside a repo.
rules_path() {
    local scope="$1"
    if [[ "$scope" == "local" ]]; then
        local top
        top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
        echo "$top/.claude/rules/stanza.md"
    else
        echo "$HOME/.claude/rules/stanza.md"
    fi
}

# Render the rule file for a scope: stamp line, blank line, rule text.
render_rules() {
    local scope="$1"
    local regen="stanza rules install"
    [[ "$scope" == "local" ]] && regen="stanza rules install --local"
    printf '<!-- %s %s (mode=%s); do not edit; regenerate with: %s -->\n\n' \
        "$RULES_MARKER" "$(get_stanza_self_version)" "$scope" "$regen"
    cat "$RULES_SOURCE"
}

# True when the file at $1 carries the generated-by-stanza marker.
has_rules_marker() {
    grep -q "$RULES_MARKER" "$1" 2>/dev/null
}

# Emit the single-location JSON document shared by install and uninstall.
emit_rules_json() {
    json_set command "rules"
    json_set action "$RULES_ACTION"
    json_set scope "$1"
    json_set path "$2"
    json_set status "$3"
    json_emit
}

rules_scope() {
    if [[ "$RULES_LOCAL" == "true" ]]; then echo "local"; else echo "global"; fi
}

rules_install() {
    local scope path
    scope=$(rules_scope)
    if ! path=$(rules_path "$scope"); then
        print_error "not in a git repository; --local needs a repo to write into"
        exit 1
    fi
    print_header "rules install" "$scope"

    if [[ -f "$path" ]] && ! has_rules_marker "$path" && [[ "$RULES_FORCE" != "true" ]]; then
        print_error "$path exists and was not generated by stanza" \
            "move it aside, or overwrite it with: stanza rules install$([[ "$scope" == "local" ]] && echo " --local") --force"
        exit 1
    fi

    local status
    if [[ -f "$path" ]] && [[ "$(render_rules "$scope")" == "$(< "$path")" ]]; then
        status="up_to_date"
        print_row current "$path"
    else
        mkdir -p "$(dirname "$path")"
        render_rules "$scope" > "$path.tmp" && mv "$path.tmp" "$path"
        status="wrote"
        print_row wrote "$path"
    fi

    emit_rules_json "$scope" "$path" "$status"
    [[ "$VERBOSITY" -le 0 && "$JSON_OUTPUT" != "true" ]] && echo "$path"
    return 0
}

rules_uninstall() {
    local scope path
    scope=$(rules_scope)
    if ! path=$(rules_path "$scope"); then
        print_error "not in a git repository; --local needs a repo to remove from"
        exit 1
    fi
    print_header "rules uninstall" "$scope"

    local status
    if [[ ! -f "$path" ]]; then
        status="absent"
        print_row absent "$path"
    elif ! has_rules_marker "$path"; then
        print_error "$path was not generated by stanza; leaving it in place"
        exit 1
    else
        rm -f "$path"
        status="removed"
        print_row removed "$path"
    fi

    emit_rules_json "$scope" "$path" "$status"
    [[ "$VERBOSITY" -le 0 && "$JSON_OUTPUT" != "true" ]] && echo "$status"
    return 0
}

# Compare every location that applies (global always; local inside a repo).
# Exits 0 only when at least one location has a file and every present file
# matches a fresh render. A stale version stamp counts as drift.
rules_check() {
    print_header "rules check"
    local scopes=(global)
    rules_path local >/dev/null && scopes+=(local)

    local scope path status present=0 bad=0 locations=""
    for scope in "${scopes[@]}"; do
        path=$(rules_path "$scope")
        if [[ ! -f "$path" ]]; then
            status="missing"
        elif [[ "$(render_rules "$scope")" == "$(< "$path")" ]]; then
            status="ok"
            present=$((present + 1))
        else
            status="drifted"
            present=$((present + 1))
            bad=$((bad + 1))
        fi
        print_row "$scope" "$(printf '%-8s %s' "$status" "$path")"
        locations="${locations},{\"scope\":\"$scope\",\"path\":\"$(json_escape "$path")\",\"status\":\"$status\"}"
    done

    local overall
    if [[ $present -eq 0 ]]; then
        overall="missing"
    elif [[ $bad -gt 0 ]]; then
        overall="drifted"
    else
        overall="ok"
    fi

    json_set command "rules"
    json_set action "check"
    json_set status "$overall"
    json_set_raw locations "[${locations#,}]"
    json_emit

    if [[ "$overall" == "ok" ]]; then
        print_done "rule is current"
        return 0
    fi
    [[ "$VERBOSITY" -le 0 && "$JSON_OUTPUT" != "true" ]] && echo "$overall"
    print_hint "regenerate with: stanza rules install (add --local for the repo copy)"
    exit 1
}

case "$RULES_ACTION" in
    print)
        if [[ "$JSON_OUTPUT" == "true" ]]; then
            json_set command "rules"
            json_set action "print"
            json_set path "$RULES_SOURCE"
            json_set content "$(< "$RULES_SOURCE")"
            json_emit
        else
            cat "$RULES_SOURCE"
        fi
        ;;
    install)   rules_install ;;
    check)     rules_check ;;
    uninstall) rules_uninstall ;;
esac
exit 0
