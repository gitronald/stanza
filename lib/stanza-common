# Check if we should skip remote operations
should_skip_remote() {
    if [[ "$LOCAL_ONLY" == "true" ]] || ! has_remote "origin"; then
        return 0  # Skip remote (true)
    fi
    return 1  # Don't skip remote (false)
}

# Run git command with output control based on verbose flag
# Usage: git_quiet push origin main
git_quiet() {
    if [[ "$VERBOSE" == "true" ]]; then
        git "$@"
    else
        git "$@" > /dev/null 2>&1
    fi
}

# Run gh command with output control based on verbose flag
# Usage: gh_quiet pr merge "$PR_NUMBER" --merge
gh_quiet() {
    if [[ "$VERBOSE" == "true" ]]; then
        gh "$@"
    else
        gh "$@" > /dev/null 2>&1
    fi
}

# User confirmation with customizable exit message
confirm_step() {
    local description="$1"
    local exit_message="${2:-Exiting workflow}"

    # Auto-confirm if -y flag is set
    if [[ "$YES_TO_ALL" == "true" ]]; then
        if [[ $VERBOSE == "true" ]]; then
            echo "$description? (y/N): y [auto-confirmed]"
        fi
        return 0
    fi

    read -p "$description? (y/N): " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "$exit_message"; exit 0;
    fi
}
